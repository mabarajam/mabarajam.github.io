/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: default-src 'self'; img-src 'self' data: https://a.basemaps.cartocdn.com; style-src 'self' 'unsafe-inline'; script-src 'self' blob:; connect-src 'self' https://a.basemaps.cartocdn.com; worker-src blob:; object-src 'none'; frame-ancestors 'none';
  Permissions-Policy: camera=(), microphone=(), geolocation=()
