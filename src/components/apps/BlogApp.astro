---
import { mediumPosts } from '../../data/mediumPosts';
---

<div class="blog-app">
  <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 18px;">
    <div>
      <h2 style="font-size: 1.1rem; font-weight: 700; color: #fff;">Security Writeups & Publications</h2>
      <p style="font-size: 0.84rem; color: var(--text-muted); margin-top: 2px;">
        Articles, hands-on lab documentation, and CTF walkthroughs.
      </p>
    </div>
    <a href="https://medium.com/@mabarajam" target="_blank" rel="noopener" class="btn-project" style="font-size: 0.78rem;">
      <i class="fa-brands fa-medium"></i>
      <span>Follow on Medium</span>
    </a>
  </div>

  <div class="blog-list">
    <!-- Internal Featured Walkthrough -->
    <article class="blog-card" style="border-color: rgba(35, 186, 194, 0.4); background: rgba(22, 32, 50, 0.85);">
      <div class="blog-card-header">
        <span class="blog-source-badge" style="background: rgba(35, 186, 194, 0.25); color: #fff;">
          <i class="fa-solid fa-star" style="margin-right: 4px; color: var(--color-yellow);"></i> FEATURED LAB
        </span>
        <span class="blog-card-date">Aug 21, 2026</span>
      </div>

      <h3 class="blog-card-title">
        <a href="/blog/splunk-log-analysis-linux" style="color: #fff;">
          Linux Log Analysis with Splunk: A SOC Analyst Walkthrough
        </a>
      </h3>

      <p style="font-size: 0.86rem; color: var(--text-secondary); line-height: 1.5;">
        How I set up centralized log collection on Linux with Splunk to detect brute-force attacks, root escalations, and port scans.
      </p>

      <div style="display: flex; align-items: center; justify-content: space-between; margin-top: 6px;">
        <div style="display: flex; gap: 6px;">
          <span class="project-tag">Splunk</span>
          <span class="project-tag">SOC</span>
          <span class="project-tag">Linux</span>
          <span class="project-tag">SIEM</span>
        </div>
        <a href="/blog/splunk-log-analysis-linux" class="btn-project" style="font-size: 0.78rem;">
          <span>Read Full Lab</span>
          <i class="fa-solid fa-arrow-right"></i>
        </a>
      </div>
    </article>

    <!-- Medium Stories -->
    {mediumPosts.map(post => (
      <article class="blog-card">
        <div class="blog-card-header">
          <span class="blog-source-badge">
            <i class="fa-brands fa-medium" style="margin-right: 4px;"></i> MEDIUM ARTICLE
          </span>
          <span class="blog-card-date">{post.date}</span>
        </div>

        <h3 class="blog-card-title">
          <a href={post.url} target="_blank" rel="noopener" style="color: #fff;">
            {post.title}
          </a>
        </h3>

        <div style="display: flex; align-items: center; justify-content: space-between; margin-top: 4px;">
          <div style="display: flex; gap: 6px; flex-wrap: wrap;">
            {post.tags.map(tag => (
              <span class="project-tag">#{tag}</span>
            ))}
          </div>

          <a href={post.url} target="_blank" rel="noopener" class="btn-project secondary" style="font-size: 0.76rem;">
            <span>Read on Medium</span>
            <i class="fa-solid fa-arrow-up-right-from-square" style="font-size: 0.7rem;"></i>
          </a>
        </div>
      </article>
    ))}
  </div>
</div>
