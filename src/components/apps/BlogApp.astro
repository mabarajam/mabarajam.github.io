---
import { mediumPosts } from '../../data/mediumPosts';
---

<div class="blog-app">
  <!-- Reader Location & Filter Bar -->
  <div class="reader-toolbar">
    <div class="reader-url-bar">
      <span class="url-protocol">https://</span>
      <span class="url-path">medium.com/@mabarajam</span>
    </div>
    <a href="https://medium.com/@mabarajam" target="_blank" rel="noopener" class="gtk-btn primary">
      <span>Follow on Medium</span>
      <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
    </a>
  </div>

  <!-- Featured Lab Walkthrough -->
  <div class="gtk-advisory-item featured">
    <div class="advisory-header-row">
      <div style="display: flex; align-items: center; gap: 8px;">
        <span class="gtk-badge featured">[FEATURED LAB]</span>
        <span class="advisory-date">Aug 21, 2026</span>
      </div>
      <span class="advisory-id">SEC-LAB-01</span>
    </div>

    <h3 class="advisory-title">
      <a href="/blog/splunk-log-analysis-linux">
        Linux Log Analysis with Splunk: A SOC Analyst Walkthrough
      </a>
    </h3>

    <p class="advisory-summary">
      Hands-on centralized log aggregation with Splunk forwarders on Linux workstations to detect brute-force SSH attacks, suspicious privilege escalations, and automated port scanning.
    </p>

    <div class="advisory-footer-row">
      <div class="advisory-tags">
        <span class="gtk-tag-pill">#splunk</span>
        <span class="gtk-tag-pill">#siem</span>
        <span class="gtk-tag-pill">#linux-security</span>
        <span class="gtk-tag-pill">#soc-walkthrough</span>
      </div>
      <a href="/blog/splunk-log-analysis-linux" class="gtk-btn primary">
        <span>Read Walkthrough</span>
        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"></polyline></svg>
      </a>
    </div>
  </div>

  <!-- Medium Security Writeups Table -->
  <div class="gtk-section-heading" style="margin: 20px 0 10px;">
    <span class="heading-tag">PUBLISHED MEDIUM WRITEUPS & LABS</span>
  </div>

  <div class="advisories-list">
    {mediumPosts.map((post, idx) => (
      <article class="gtk-advisory-item">
        <div class="advisory-header-row">
          <div style="display: flex; align-items: center; gap: 8px;">
            <span class="gtk-badge">[MEDIUM]</span>
            <span class="advisory-date">{post.date}</span>
          </div>
          <span class="advisory-id">PUB-0{idx + 1}</span>
        </div>

        <h4 class="advisory-title">
          <a href={post.url} target="_blank" rel="noopener">
            {post.title}
          </a>
        </h4>

        <div class="advisory-footer-row">
          <div class="advisory-tags">
            {post.tags.map(tag => (
              <span class="gtk-tag-pill">#{tag}</span>
            ))}
          </div>

          <a href={post.url} target="_blank" rel="noopener" class="gtk-btn">
            <span>Read Article</span>
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
          </a>
        </div>
      </article>
    ))}
  </div>
</div>
