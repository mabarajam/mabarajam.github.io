---
import { profile } from '../../data/profile';
---

<div class="contact-app">
  <!-- Mail Header Form -->
  <div class="mail-composer-card">
    <div class="mail-field-row">
      <span class="mail-field-label">To:</span>
      <div class="mail-field-value">
        <span class="recipient-name">Mario Barajas</span>
        <span class="recipient-address">&lt;{profile.email}&gt;</span>
      </div>
    </div>

    <div class="mail-field-row">
      <span class="mail-field-label">Subject:</span>
      <div class="mail-field-value subject">
        <span>Cybersecurity Analyst Role / Security Inquiries</span>
      </div>
    </div>

    <div class="mail-field-row">
      <span class="mail-field-label">Security:</span>
      <div class="mail-field-value security">
        <span class="pgp-badge">TLS / PROTONMAIL ENCRYPTION</span>
        <span class="location-badge">Location: {profile.location} (Remote / Hybrid)</span>
      </div>
    </div>

    <!-- Action Bar -->
    <div class="mail-action-toolbar">
      <a href={`mailto:${profile.email}`} class="gtk-btn primary" title="Launch default email client">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg>
        <span>Send Email</span>
      </a>

      <button class="gtk-btn" id="copy-email-btn" title="Copy email address to clipboard">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
        <span id="copy-btn-text">Copy Address</span>
      </button>

      <a href="/resume.pdf" download={profile.resumeFileName} class="gtk-btn" title="Download resume PDF">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
        <span>Download Resume</span>
      </a>
    </div>

    <!-- Message Body Console -->
    <div class="mail-body-pane">
      <div class="mail-body-text">
        <p>Hello Mario,</p>
        <p>I reviewed your cybersecurity portfolio and would like to connect regarding open SOC / Security Analyst opportunities in Vancouver, BC or remote teams.</p>
        <p>Key competencies of interest: Threat Monitoring, Splunk/Wazuh SIEM log triage, Nessus vulnerability management, and hands-on lab projects.</p>
        <p class="mail-signoff">Looking forward to speaking with you.</p>
      </div>
    </div>

    <!-- Contact Channels & Socials -->
    <div class="mail-channels-row">
      <div class="channels-label">Direct Communication Channels:</div>
      <div class="channels-buttons">
        {profile.socials.map(s => (
          <a href={s.url} target="_blank" rel="noopener" class="gtk-btn small">
            <span>{s.label}</span>
            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
          </a>
        ))}
      </div>
    </div>
  </div>
</div>

<script>
  function setupContactApp() {
    const copyBtn = document.getElementById('copy-email-btn');
    const copyTxt = document.getElementById('copy-btn-text');
    if (!copyBtn || !copyTxt) return;

    copyBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText('Defensium@protonmail.com');
        copyTxt.innerText = 'Copied!';
        setTimeout(() => {
          copyTxt.innerText = 'Copy Address';
        }, 2000);
      } catch (err) {
        copyTxt.innerText = 'Defensium@protonmail.com';
      }
    });
  }

  setupContactApp();
  document.addEventListener('astro:after-swap', setupContactApp);
</script>
