---
// TerminalApp.astro - Authentic Kali Zsh terminal
---

<div class="terminal-app" id="kali-terminal-component">
  <div class="terminal-output" id="terminal-output-container">
    <div class="terminal-line" style="color: #61afef;">
      Kali GNU/Linux Rolling 2026.3 • Kernel 6.8.0-kali-amd64
    </div>
    <div class="terminal-line" style="color: #98c379;">
      Type '<strong>help</strong>' to display available commands or '<strong>neofetch</strong>' for system information.
    </div>
    <div class="terminal-line" style="margin-bottom: 8px;"></div>
  </div>

  <form class="terminal-input-row" id="terminal-form" autocomplete="off">
    <div class="kali-zsh-prompt-block">
      <div class="zsh-prompt-top">
        <span class="zsh-c-blue">┌──(</span><span class="zsh-c-user">mario</span><span class="zsh-c-at">㉿</span><span class="zsh-c-host">kali</span><span class="zsh-c-blue">)-[</span><span class="zsh-c-white">~</span><span class="zsh-c-blue">]</span>
      </div>
      <div class="zsh-prompt-bottom">
        <span class="zsh-c-blue">└─</span><span class="zsh-c-symbol">$</span>
        <input type="text" id="terminal-cli-input" class="terminal-input" autofocus spellcheck="false" aria-label="Terminal command input" />
      </div>
    </div>
  </form>
</div>

<script>
  function initTerminal() {
    const container = document.getElementById('kali-terminal-component');
    const form = document.getElementById('terminal-form');
    const input = document.getElementById('terminal-cli-input') as HTMLInputElement;
    const output = document.getElementById('terminal-output-container');
    if (!form || !input || !output || !container) return;

    // Prevent duplicate binding
    if (form.dataset.ready === 'true') return;
    form.dataset.ready = 'true';

    // Focus input on click anywhere in terminal
    container.addEventListener('click', () => {
      input.focus();
    });

    const appendLine = (html: string, color = '') => {
      const line = document.createElement('div');
      line.className = 'terminal-line';
      if (color) line.style.color = color;
      line.innerHTML = html;
      output.appendChild(line);
      output.scrollTop = output.scrollHeight;
    };

    const cmdHistory: string[] = [];
    let historyCursor = -1;

    // Up / Down arrow history
    input.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowUp') {
        e.preventDefault();
        if (cmdHistory.length === 0) return;
        if (historyCursor === -1) {
          historyCursor = cmdHistory.length - 1;
        } else if (historyCursor > 0) {
          historyCursor--;
        }
        input.value = cmdHistory[historyCursor] || '';
      } else if (e.key === 'ArrowDown') {
        e.preventDefault();
        if (historyCursor !== -1) {
          if (historyCursor < cmdHistory.length - 1) {
            historyCursor++;
            input.value = cmdHistory[historyCursor];
          } else {
            historyCursor = -1;
            input.value = '';
          }
        }
      }
    });

    const commands: Record<string, () => void> = {
      help: () => {
        appendLine(`
<span style="color: #61afef; font-weight: bold;">AVAILABLE COMMANDS:</span>
  <span style="color: #98c379;">whoami</span>        - Display analyst credentials and summary
  <span style="color: #98c379;">neofetch</span>      - Print official Kali dragon & workstation specs
  <span style="color: #98c379;">ls [dir]</span>      - List directories, projects or certificates
  <span style="color: #98c379;">skills</span>        - Technical skills & security tools list
  <span style="color: #98c379;">certs</span>         - List certifications & credentials
  <span style="color: #98c379;">projects</span>      - Open Thunar projects directory
  <span style="color: #98c379;">map / trace</span>   - Launch network traceroute diagnostic map
  <span style="color: #98c379;">open &lt;app&gt;</span>    - Open GUI window (about, projects, certs, map, resume, blog, contact)
  <span style="color: #98c379;">contact</span>       - Display contact channels and email
  <span style="color: #98c379;">decrypt email</span> - Execute decrypted email handshake
  <span style="color: #98c379;">resume</span>        - Download or preview Mario's resume PDF
  <span style="color: #98c379;">clear</span>         - Clear the terminal screen
  <span style="color: #98c379;">sudo hire-mario</span>- Execute security analyst onboarding script
`);
      },

      whoami: () => {
        appendLine(`
<strong style="color: #61afef;">Mario Barajas</strong> — Cybersecurity Analyst based in Vancouver, BC.
CompTIA Security+ (SY0-701) • Threat Detection • Splunk/Wazuh SIEM • Vulnerability Assessment • Web Pentesting.
`);
      },

      neofetch: () => {
        appendLine(`
<div style="display: flex; gap: 20px; font-family: monospace; line-height: 1.25;">
<div style="color: #2777ff; white-space: pre;">
..............
            ..,;:ccc,.
          ......''';lxO.
.....''''..........,:ld;
           .';;;:::;,,.x,
      ..'''.            0Xxoc:,.  ...
  ....                ,ONkc;,;cokOdc',.
 .                   OMo           ':ddo.
                    dMc               :OO;
                    0M.                 .:o.
                    ;Wd
                     ;XO,
                       ,d0Odlc;,..
                           ..',;:cdOOd::,.
                                    .:d;.':;.
                                       'd,  .'
                                         ;l   ..
                                          .o
                                            c
                                            .'
                                             .
</div>
<div>
<span style="color: #61afef; font-weight: bold;">mario</span>@<span style="color: #23bac2; font-weight: bold;">kali-workstation</span>
---------------------------
<span style="color: #61afef; font-weight: bold;">OS:</span> Kali GNU/Linux Rolling x86_64
<span style="color: #61afef; font-weight: bold;">Host:</span> Vancouver, BC, Canada
<span style="color: #61afef; font-weight: bold;">Kernel:</span> 6.8.0-kali-amd64
<span style="color: #61afef; font-weight: bold;">Uptime:</span> 6+ years in IT & Systems
<span style="color: #61afef; font-weight: bold;">Packages:</span> 2842 (dpkg)
<span style="color: #61afef; font-weight: bold;">Shell:</span> zsh 5.9
<span style="color: #61afef; font-weight: bold;">WM:</span> Xfwm4 (Kali-Dark)
<span style="color: #61afef; font-weight: bold;">Theme:</span> Kali-Dark [GTK2/3]
<span style="color: #61afef; font-weight: bold;">Icons:</span> Flat-Remix-Blue [GTK2/3]
<span style="color: #61afef; font-weight: bold;">Terminal:</span> qterminal
<span style="color: #61afef; font-weight: bold;">Cert:</span> <span style="color: #98c379;">CompTIA Security+ (SY0-701)</span>
<span style="color: #61afef; font-weight: bold;">Status:</span> <span style="color: #e5c07b;">Open to SOC / Analyst roles</span>
</div>
</div>
`);
      },

      ls: () => {
        appendLine(`
<span style="color: #61afef; font-weight: bold;">projects/</span>       <span style="color: #e5c07b; font-weight: bold;">credentials/</span>    profile.txt     Resume.pdf
<span style="color: #98c379; font-weight: bold;">blog/</span>           <span style="color: #c678dd; font-weight: bold;">labs/</span>           skills.json     trace_route.sh
`);
      },

      skills: () => {
        appendLine(`
<span style="color: #61afef; font-weight: bold;">TECHNICAL COMPETENCIES:</span>
- <strong style="color: #fff;">SIEM & Monitoring:</strong> Splunk Enterprise, Wazuh, Syslog, Auth logs
- <strong style="color: #fff;">Scanning & Vulnerability:</strong> Nmap, Nessus Essentials, OpenVAS, Wireshark
- <strong style="color: #fff;">Offensive Security:</strong> Burp Suite, SQL Injection, XSS, Fernet Crypto, Python
- <strong style="color: #fff;">Systems & Networks:</strong> Linux (Debian/Kali/Ubuntu), TCP/IP, CCTV/DVR/NVR
`);
      },

      certs: () => {
        appendLine(`
<span style="color: #e5c07b; font-weight: bold;">CREDENTIALS & CERTIFICATIONS:</span>
1. CompTIA Security+ (SY0-701) - 2026
2. Cybersecurity Specialist (Cornerstone)
3. Networking Basics (CISCO)
4. Network-Focused Security
5. Cybersecurity Fundamentals
6. Cloud Security Fundamentals
7. AI Development
`);
      },

      projects: () => {
        appendLine(`Opening projects directory in Thunar File Manager...`);
        window.dispatchEvent(new CustomEvent('kali:open-app', { detail: { app: 'projects' } }));
      },

      map: () => {
        appendLine(`Launching network traceroute diagnostic...`);
        window.dispatchEvent(new CustomEvent('kali:open-app', { detail: { app: 'map' } }));
      },

      traceroute: () => {
        appendLine(`Launching network traceroute diagnostic...`);
        window.dispatchEvent(new CustomEvent('kali:open-app', { detail: { app: 'map' } }));
      },

      trace: () => {
        appendLine(`Launching network traceroute diagnostic...`);
        window.dispatchEvent(new CustomEvent('kali:open-app', { detail: { app: 'map' } }));
      },

      experience: () => {
        appendLine(`Opening career history log...`);
        window.dispatchEvent(new CustomEvent('kali:open-app', { detail: { app: 'experience' } }));
      },

      blog: () => {
        appendLine(`Opening security writeups reader...`);
        window.dispatchEvent(new CustomEvent('kali:open-app', { detail: { app: 'blog' } }));
      },

      contact: () => {
        appendLine(`
<span style="color: #61afef; font-weight: bold;">CONTACT:</span>
- Email: <a href="mailto:Defensium@protonmail.com" style="color: #98c379;">Defensium@protonmail.com</a>
- LinkedIn: <a href="https://www.linkedin.com/in/marioabarajas/" target="_blank" style="color: #61afef;">linkedin.com/in/marioabarajas</a>
- Medium: <a href="https://medium.com/@mabarajam" target="_blank" style="color: #61afef;">medium.com/@mabarajam</a>
- GitHub: <a href="https://github.com/mabarajam" target="_blank" style="color: #61afef;">github.com/mabarajam</a>
`);
      },

      resume: () => {
        appendLine(`Opening resume viewer...`);
        window.dispatchEvent(new CustomEvent('kali:open-app', { detail: { app: 'resume' } }));
      },

      clear: () => {
        output.innerHTML = '';
      },
    };

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const raw = input.value.trim();
      input.value = '';
      if (!raw) return;

      cmdHistory.push(raw);
      historyCursor = -1;

      // Echo command with prompt
      appendLine(`
<div style="color: #61afef;">┌──(mario㉿kali)-[~]</div>
<div>└─$ ${raw}</div>
      `);

      const parts = raw.split(' ');
      const cmd = parts[0].toLowerCase();
      const arg = parts.slice(1).join(' ').toLowerCase();

      if (raw === 'sudo hire-mario') {
        appendLine(`
<span style="color: #98c379; font-weight: bold;">[SUCCESS]</span> Initializing onboarding protocol:
Candidate <strong style="color: #61afef;">Mario Barajas</strong> identified as high-value addition to security operations.
Skills: Threat detection, incident response, SIEM log analysis, and proactive defense.
Contact channel established at: <a href="mailto:Defensium@protonmail.com" style="color: #fff;">Defensium@protonmail.com</a>
`);
        return;
      }

      if (raw === 'decrypt email') {
        appendLine(`[Handshake established]: Decrypting private transmission...`);
        let count = 0;
        const temp = document.createElement('div');
        temp.className = 'terminal-line';
        temp.style.color = '#e06c75';
        output.appendChild(temp);
        const chars = 'ABCDEF0123456789!@#$%';
        const target = 'Defensium@protonmail.com';
        const timer = setInterval(() => {
          count++;
          if (count > 15) {
            clearInterval(timer);
            temp.style.color = '#98c379';
            temp.innerHTML = `[SUCCESS] Decrypted Email: <strong>${target}</strong>`;
          } else {
            temp.innerText = Array.from({ length: 24 }).map(() => chars[Math.floor(Math.random() * chars.length)]).join('');
          }
        }, 50);
        return;
      }

      if (cmd === './trace_route.sh' || cmd === 'trace_route.sh' || cmd === 'sh trace_route.sh') {
        commands.map();
        return;
      }

      if (cmd === 'open') {
        const appMap: Record<string, string> = {
          about: 'about',
          projects: 'projects',
          project: 'projects',
          certs: 'certs',
          certificates: 'certs',
          cert: 'certs',
          map: 'map',
          traceroute: 'map',
          experience: 'experience',
          exp: 'experience',
          resume: 'resume',
          cv: 'resume',
          blog: 'blog',
          contact: 'contact',
          email: 'contact',
          terminal: 'terminal',
          term: 'terminal',
          qterminal: 'terminal',
        };
        const targetApp = appMap[arg];
        if (targetApp) {
          appendLine(`Launching application [${targetApp}]...`);
          window.dispatchEvent(new CustomEvent('kali:open-app', { detail: { app: targetApp } }));
        } else {
          appendLine(`Unknown window target: '${arg}'. Available apps: about, projects, certs, map, experience, blog, contact, resume, terminal.`);
        }
        return;
      }

      if (cmd === 'cat') {
        if (arg === 'profile.txt' || arg === 'profile') {
          commands.whoami();
        } else if (arg === 'certs.txt' || arg === 'certs') {
          commands.certs();
        } else if (arg === 'skills.json' || arg === 'skills') {
          commands.skills();
        } else if (arg === 'resume.pdf' || arg === 'resume') {
          appendLine(`[Binary PDF file] Opening in Document Viewer...`);
          commands.resume();
        } else if (arg === 'trace_route.sh') {
          appendLine(`#!/bin/bash\n# ICMP Traceroute to Vancouver SOC base\ntraceroute -q 3 -w 2 49.2827,-123.1207`);
        } else {
          appendLine(`cat: ${arg || 'file'}: No such file or directory. Try 'ls' to view files.`);
        }
        return;
      }

      if (commands[cmd]) {
        commands[cmd]();
      } else {
        appendLine(`zsh: command not found: ${cmd}. Type '<span style="color: #61afef;">help</span>' for a list of commands.`, '#e06c75');
      }
    });

    // Focus terminal input helper
    const focusTerminal = () => {
      input.focus({ preventScroll: true });
    };

    // Auto-focus when clicking or tapping anywhere in terminal body
    container.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).tagName !== 'A') {
        focusTerminal();
      }
    });

    container.addEventListener('touchend', (e) => {
      if ((e.target as HTMLElement).tagName !== 'A') {
        focusTerminal();
      }
    });

    window.addEventListener('kali:open-app', (e: any) => {
      if (e.detail?.app === 'terminal') {
        setTimeout(focusTerminal, 60);
      }
    });

    // Auto-focus if terminal is active on load
    setTimeout(focusTerminal, 80);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initTerminal);
  } else {
    initTerminal();
  }
  document.addEventListener('astro:after-swap', initTerminal);
</script>
