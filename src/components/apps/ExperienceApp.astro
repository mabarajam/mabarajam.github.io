---
import { relevantExperience, pastCareers, educationList, certificationsList } from '../../data/experience';
---

<div class="experience-app">
  <!-- GTK Notebook Tab Bar -->
  <div class="gtk-notebook-tabs" role="tablist">
    <button class="gtk-tab-btn active" data-tab="relevant" role="tab" aria-selected="true">
      <span>Relevant Cybersecurity Experience</span>
    </button>
    <button class="gtk-tab-btn" data-tab="past" role="tab" aria-selected="false">
      <span>Past Career History</span>
    </button>
    <button class="gtk-tab-btn" data-tab="education" role="tab" aria-selected="false">
      <span>Education & Certifications</span>
    </button>
  </div>

  <!-- Tab 1: Relevant Experience -->
  <div class="gtk-tab-page active" id="tab-relevant" role="tabpanel">
    <div class="gtk-ledger-list">
      {relevantExperience.map(exp => (
        <div class="gtk-ledger-entry">
          <div class="entry-header-row">
            <span class="entry-badge">[EXPERIENCE]</span>
            <h3 class="entry-title">{exp.role}</h3>
          </div>
          <div class="entry-meta-bar">
            <span><strong>Organization:</strong> {exp.company}</span>
            <span><strong>Location:</strong> {exp.location}</span>
            <span><strong>Period:</strong> {exp.period}</span>
          </div>
          <ul class="entry-bullet-list">
            {exp.bullets.map(b => (
              <li>
                <span class="bullet-symbol">></span>
                <span>{b}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>

  <!-- Tab 2: Past Career Experience -->
  <div class="gtk-tab-page" id="tab-past" role="tabpanel" style="display: none;">
    <div class="gtk-ledger-list">
      {pastCareers.map(exp => (
        <div class="gtk-ledger-entry">
          <div class="entry-header-row">
            <span class="entry-badge past">[CAREER]</span>
            <h3 class="entry-title">{exp.role}</h3>
          </div>
          <div class="entry-meta-bar">
            <span><strong>Company:</strong> {exp.company}</span>
            <span><strong>Location:</strong> {exp.location}</span>
            <span><strong>Period:</strong> {exp.period}</span>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- Tab 3: Education & Certifications -->
  <div class="gtk-tab-page" id="tab-education" role="tabpanel" style="display: none;">
    <div class="gtk-section-heading">
      <span class="heading-tag">ACADEMIC CREDENTIALS</span>
    </div>

    <div class="gtk-ledger-list" style="margin-bottom: 24px;">
      {educationList.map(edu => (
        <div class="gtk-ledger-entry">
          <div class="entry-header-row">
            <span class="entry-badge edu">[DEGREE]</span>
            <h4 class="entry-title">{edu.degree}</h4>
          </div>
          <div class="entry-meta-bar">
            <span><strong>Institution:</strong> {edu.school}</span>
            <span><strong>Location:</strong> {edu.location}</span>
            <span><strong>Year:</strong> {edu.year}</span>
          </div>
          {edu.coursework && (
            <div class="entry-coursework-note">
              <strong>Coursework Scope:</strong> {edu.coursework}
            </div>
          )}
        </div>
      ))}
    </div>

    <div class="gtk-section-heading">
      <span class="heading-tag">VERIFIED SECURITY CERTIFICATIONS</span>
    </div>

    <div class="gtk-ledger-list">
      {certificationsList.map(cert => (
        <div class="gtk-ledger-entry">
          <div class="entry-header-row">
            <span class="entry-badge cert">[VERIFIED]</span>
            <h4 class="entry-title">{cert.name}</h4>
          </div>
          <div class="entry-meta-bar">
            <span><strong>Issuing Body:</strong> {cert.issuer}</span>
            <span><strong>Issued:</strong> {cert.year}</span>
            <span><strong>Status:</strong> Active Credential</span>
          </div>
        </div>
      ))}
    </div>
  </div>
</div>

<script>
  function setupExpTabs() {
    const tabs = document.querySelectorAll('.gtk-tab-btn');
    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        tabs.forEach(t => {
          t.classList.remove('active');
          t.setAttribute('aria-selected', 'false');
        });
        tab.classList.add('active');
        tab.setAttribute('aria-selected', 'true');

        const target = tab.getAttribute('data-tab');
        document.querySelectorAll('.gtk-tab-page').forEach(page => {
          (page as HTMLElement).style.display = 'none';
        });

        const activePage = document.getElementById(`tab-${target}`);
        if (activePage) activePage.style.display = 'block';
      });
    });
  }

  setupExpTabs();
  document.addEventListener('astro:after-swap', setupExpTabs);
</script>
