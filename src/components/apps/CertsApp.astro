---
import { certificates } from '../../data/certs';
---

<div class="ristretto-viewer">
  <!-- Ristretto Viewer Navigation & Zoom Toolbar -->
  <div class="ristretto-toolbar">
    <div class="ristretto-btn-group">
      <button class="gtk-toolbar-btn" id="ristretto-prev-btn" title="Previous Image (Left Arrow)" aria-label="Previous image">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"></polyline></svg>
        <span>Previous</span>
      </button>
      <button class="gtk-toolbar-btn" id="ristretto-next-btn" title="Next Image (Right Arrow)" aria-label="Next image">
        <span>Next</span>
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"></polyline></svg>
      </button>
    </div>

    <div class="ristretto-divider"></div>

    <div class="ristretto-btn-group">
      <button class="gtk-toolbar-btn" id="ristretto-zoom-100" title="1:1 Pixel Scale">
        <span>100%</span>
      </button>
      <button class="gtk-toolbar-btn" id="ristretto-fullscreen-btn" title="Full Window Inspection">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"></path></svg>
        <span>Inspect</span>
      </button>
    </div>

    <div class="ristretto-info-label" id="ristretto-counter">
      1 of {certificates.length} credentials
    </div>
  </div>

  <!-- Main Image Display Canvas -->
  <div class="ristretto-canvas" id="ristretto-canvas">
    <img
      id="ristretto-main-img"
      src={certificates[0]?.image}
      alt={certificates[0]?.title}
      class="ristretto-current-image"
    />
  </div>

  <!-- Metadata Bar -->
  <div class="ristretto-meta-bar">
    <div class="ristretto-cert-info">
      <span class="meta-title" id="ristretto-cert-title">{certificates[0]?.title}</span>
      <span class="meta-caption" id="ristretto-cert-caption">{certificates[0]?.caption}</span>
    </div>
    <div class="ristretto-file-spec">
      <span class="spec-tag">FORMAT: PNG</span>
      <span class="spec-tag">COLOR: 24-bit RGB</span>
      <span class="spec-tag">SECURITY CREDENTIAL</span>
    </div>
  </div>

  <!-- Bottom Thumbnails Filmstrip -->
  <div class="ristretto-filmstrip" id="ristretto-filmstrip">
    {certificates.map((cert, index) => (
      <div
        class={`filmstrip-thumb ${index === 0 ? 'active' : ''}`}
        data-index={index}
        data-src={cert.image}
        data-title={cert.title}
        data-caption={cert.caption}
        tabindex="0"
        role="button"
        aria-label={`View ${cert.title}`}
      >
        <img src={cert.image} alt={cert.title} loading="lazy" />
        <span class="thumb-label">{cert.title}</span>
      </div>
    ))}
  </div>
</div>

<!-- Lightbox Modal for Inspection -->
<div class="cert-lightbox-modal" id="kali-cert-modal" role="dialog" aria-label="Certificate Image Viewer">
  <button class="cert-modal-close" id="cert-modal-close" aria-label="Close viewer">✕</button>

  <button class="cert-modal-nav prev" id="cert-modal-prev" aria-label="Previous certificate">‹</button>
  <button class="cert-modal-nav next" id="cert-modal-next" aria-label="Next certificate">›</button>

  <div class="cert-modal-content">
    <img id="cert-modal-img" class="cert-modal-img" src="" alt="Certificate View" />
    <div id="cert-modal-caption" class="cert-modal-caption"></div>
  </div>
</div>

<script>
  function setupRistrettoViewer() {
    const mainImg = document.getElementById('ristretto-main-img') as HTMLImageElement;
    const titleEl = document.getElementById('ristretto-cert-title');
    const captionEl = document.getElementById('ristretto-cert-caption');
    const counterEl = document.getElementById('ristretto-counter');
    const prevBtn = document.getElementById('ristretto-prev-btn');
    const nextBtn = document.getElementById('ristretto-next-btn');
    const fullscreenBtn = document.getElementById('ristretto-fullscreen-btn');
    const thumbs = Array.from(document.querySelectorAll('.filmstrip-thumb'));

    // Modal elements
    const modal = document.getElementById('kali-cert-modal');
    const modalImg = document.getElementById('cert-modal-img') as HTMLImageElement;
    const modalCaption = document.getElementById('cert-modal-caption');
    const modalClose = document.getElementById('cert-modal-close');
    const modalPrev = document.getElementById('cert-modal-prev');
    const modalNext = document.getElementById('cert-modal-next');

    if (!mainImg || thumbs.length === 0) return;

    let currentIndex = 0;

    const showIndex = (idx: number) => {
      currentIndex = (idx + thumbs.length) % thumbs.length;
      thumbs.forEach((t, i) => t.classList.toggle('active', i === currentIndex));

      const activeThumb = thumbs[currentIndex];
      const src = activeThumb.getAttribute('data-src') || '';
      const title = activeThumb.getAttribute('data-title') || '';
      const caption = activeThumb.getAttribute('data-caption') || '';

      mainImg.style.opacity = '0.3';
      setTimeout(() => {
        mainImg.src = src;
        mainImg.alt = title;
        mainImg.style.opacity = '1';
      }, 80);

      if (titleEl) titleEl.innerText = title;
      if (captionEl) captionEl.innerText = caption;
      if (counterEl) counterEl.innerText = `${currentIndex + 1} of ${thumbs.length} credentials`;

      // Keep active thumbnail visible in filmstrip
      activeThumb.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
    };

    thumbs.forEach((thumb, idx) => {
      thumb.addEventListener('click', () => showIndex(idx));
      thumb.addEventListener('keydown', (e: any) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          showIndex(idx);
        }
      });
    });

    prevBtn?.addEventListener('click', () => showIndex(currentIndex - 1));
    nextBtn?.addEventListener('click', () => showIndex(currentIndex + 1));

    // Fullscreen / Modal Inspection
    const openModal = () => {
      if (!modal || !modalImg || !modalCaption) return;
      const activeThumb = thumbs[currentIndex];
      modalImg.src = activeThumb.getAttribute('data-src') || '';
      modalCaption.innerText = activeThumb.getAttribute('data-caption') || '';
      modal.classList.add('active');
    };

    fullscreenBtn?.addEventListener('click', openModal);
    mainImg.addEventListener('click', openModal);

    modalClose?.addEventListener('click', () => modal?.classList.remove('active'));
    modalPrev?.addEventListener('click', (e) => {
      e.stopPropagation();
      showIndex(currentIndex - 1);
      if (modalImg && modalCaption) {
        modalImg.src = thumbs[currentIndex].getAttribute('data-src') || '';
        modalCaption.innerText = thumbs[currentIndex].getAttribute('data-caption') || '';
      }
    });
    modalNext?.addEventListener('click', (e) => {
      e.stopPropagation();
      showIndex(currentIndex + 1);
      if (modalImg && modalCaption) {
        modalImg.src = thumbs[currentIndex].getAttribute('data-src') || '';
        modalCaption.innerText = thumbs[currentIndex].getAttribute('data-caption') || '';
      }
    });
    modal?.addEventListener('click', (e) => {
      if (e.target === modal) modal.classList.remove('active');
    });
  }

  setupRistrettoViewer();
  document.addEventListener('astro:after-swap', setupRistrettoViewer);
</script>
