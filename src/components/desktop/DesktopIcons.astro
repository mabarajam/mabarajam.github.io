---
// DesktopIcons.astro - Desktop shortcuts
---

<div class="desktop-icons-area" id="desktop-icons">
  <div class="desktop-icon" data-app="about" tabindex="0" role="button" aria-label="Open Home">
    <div class="desktop-icon-img">
      <i class="fa-solid fa-house-laptop" style="color: #38bdf8;"></i>
    </div>
    <span class="desktop-icon-label">About Mario</span>
  </div>

  <div class="desktop-icon" data-app="projects" tabindex="0" role="button" aria-label="Open Projects">
    <div class="desktop-icon-img">
      <i class="fa-solid fa-folder-closed" style="color: #60a5fa;"></i>
    </div>
    <span class="desktop-icon-label">Projects</span>
  </div>

  <div class="desktop-icon" data-app="certs" tabindex="0" role="button" aria-label="Open Certificates">
    <div class="desktop-icon-img">
      <i class="fa-solid fa-ribbon" style="color: #fbbf24;"></i>
    </div>
    <span class="desktop-icon-label">Certificates</span>
  </div>

  <div class="desktop-icon" data-app="map" tabindex="0" role="button" aria-label="Open Map">
    <div class="desktop-icon-img">
      <i class="fa-solid fa-compass" style="color: #2dd4bf;"></i>
    </div>
    <span class="desktop-icon-label">Route Map</span>
  </div>

  <div class="desktop-icon" data-app="resume" tabindex="0" role="button" aria-label="Open Resume">
    <div class="desktop-icon-img">
      <i class="fa-solid fa-file-pdf" style="color: #ef4444;"></i>
    </div>
    <span class="desktop-icon-label">Resume.pdf</span>
  </div>

  <div class="desktop-icon" data-app="terminal" tabindex="0" role="button" aria-label="Open Terminal">
    <div class="desktop-icon-img">
      <i class="fa-solid fa-square-terminal" style="color: #f43f5e;"></i>
    </div>
    <span class="desktop-icon-label">Terminal</span>
  </div>

  <a href="https://mabarajam.github.io/CompTIASecurity-Practice/" target="_blank" rel="noopener" class="desktop-icon" aria-label="Open Security+ Practice Lab">
    <div class="desktop-icon-img">
      <i class="fa-solid fa-microscope" style="color: #f59e0b;"></i>
    </div>
    <span class="desktop-icon-label">Labs</span>
  </a>

  <a href="/simple" class="desktop-icon" aria-label="Open Simple View">
    <div class="desktop-icon-img">
      <i class="fa-solid fa-file-lines" style="color: #a78bfa;"></i>
    </div>
    <span class="desktop-icon-label">Simple View</span>
  </a>
</div>
