---
// DesktopIcons.astro - Authentic Kali Desktop shortcuts
---

<div class="desktop-icons-area" id="desktop-icons">
  <div class="desktop-icon" data-app="about" tabindex="0" role="button" aria-label="Open System Details">
    <div class="desktop-icon-img">
      <img src="/icons/app-info.svg" alt="" width="38" height="38" />
    </div>
    <span class="desktop-icon-label">About-System</span>
  </div>

  <div class="desktop-icon" data-app="projects" tabindex="0" role="button" aria-label="Open Projects">
    <div class="desktop-icon-img">
      <img src="/icons/app-folder.svg" alt="" width="38" height="38" />
    </div>
    <span class="desktop-icon-label">projects</span>
  </div>

  <div class="desktop-icon" data-app="experience" tabindex="0" role="button" aria-label="Open Experience">
    <div class="desktop-icon-img">
      <img src="/icons/app-experience.svg" alt="" width="38" height="38" />
    </div>
    <span class="desktop-icon-label">experience</span>
  </div>

  <div class="desktop-icon" data-app="certs" tabindex="0" role="button" aria-label="Open Certificates">
    <div class="desktop-icon-img">
      <img src="/icons/app-certs.svg" alt="" width="38" height="38" />
    </div>
    <span class="desktop-icon-label">credentials</span>
  </div>

  <div class="desktop-icon" data-app="blog" tabindex="0" role="button" aria-label="Open Writeups and Blog">
    <div class="desktop-icon-img">
      <img src="/icons/app-blog.svg" alt="" width="38" height="38" />
    </div>
    <span class="desktop-icon-label">writeups</span>
  </div>

  <div class="desktop-icon" data-app="terminal" tabindex="0" role="button" aria-label="Open Terminal">
    <div class="desktop-icon-img">
      <img src="/icons/app-terminal.svg" alt="" width="38" height="38" />
    </div>
    <span class="desktop-icon-label">terminal</span>
  </div>

  <div class="desktop-icon" data-app="map" tabindex="0" role="button" aria-label="Open Traceroute Map">
    <div class="desktop-icon-img">
      <img src="/icons/app-map.svg" alt="" width="38" height="38" />
    </div>
    <span class="desktop-icon-label">traceroute</span>
  </div>

  <div class="desktop-icon" data-app="resume" tabindex="0" role="button" aria-label="Open Resume PDF">
    <div class="desktop-icon-img">
      <img src="/icons/app-pdf.svg" alt="" width="38" height="38" />
    </div>
    <span class="desktop-icon-label">Resume.pdf</span>
  </div>

  <a href="https://mabarajam.github.io/CompTIASecurity-Practice/" target="_blank" rel="noopener" class="desktop-icon" aria-label="Open Security+ Practice Lab">
    <div class="desktop-icon-img">
      <img src="/icons/app-lab.svg" alt="" width="38" height="38" />
    </div>
    <span class="desktop-icon-label">sec-plus-lab</span>
  </a>

  <a href="/simple" class="desktop-icon" aria-label="Open Simple View">
    <div class="desktop-icon-img">
      <svg width="38" height="38" viewBox="0 0 24 24" fill="none" stroke="#23bac2" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line></svg>
    </div>
    <span class="desktop-icon-label">Simple-View</span>
  </a>
</div>
