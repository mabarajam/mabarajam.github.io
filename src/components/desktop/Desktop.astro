---
import TopBar from './TopBar.astro';
import Dock from './Dock.astro';
import DesktopIcons from './DesktopIcons.astro';
import Window from './Window.astro';
import BootScreen from './BootScreen.astro';

import AboutApp from '../apps/AboutApp.astro';
import ProjectsApp from '../apps/ProjectsApp.astro';
import ExperienceApp from '../apps/ExperienceApp.astro';
import CertsApp from '../apps/CertsApp.astro';
import TerminalApp from '../apps/TerminalApp.astro';
import MapApp from '../apps/MapApp.astro';
import BlogApp from '../apps/BlogApp.astro';
import ContactApp from '../apps/ContactApp.astro';
import ResumeApp from '../apps/ResumeApp.astro';

export interface Props {
  initialApp?: string;
}

const { initialApp = 'about' } = Astro.props;
---

<div class="desktop-container" id="kali-desktop" data-initial-app={initialApp}>
  <div class="desktop-vignette"></div>

  <!-- Boot splash sequence (only first visit in session) -->
  <BootScreen />

  <!-- Top XFCE / Kali Status Bar -->
  <TopBar />

  <!-- Desktop Icons Grid -->
  <DesktopIcons />

  <!-- Windows Container -->
  <main class="windows-container" id="windows-container">
    <!-- 1. About Mario Window -->
    <Window
      id="win-about"
      app="about"
      title="System Profiler — Mario Barajas"
      iconSrc="/icons/app-info.svg"
      menuItems={['File', 'View', 'Help']}
      statusText="System status: Active • CompTIA Security+ Certified"
      defaultWidth="840px"
      defaultHeight="580px"
      defaultTop="42px"
      defaultLeft="140px"
    >
      <AboutApp />
    </Window>

    <!-- 2. Projects (Thunar Files) Window -->
    <Window
      id="win-projects"
      app="projects"
      title="projects — Thunar File Manager"
      iconSrc="/icons/app-folder.svg"
      menuItems={['File', 'Edit', 'View', 'Go', 'Help']}
      statusText="5 directories • 1 selected • Free space: 84.2 GB"
      defaultWidth="890px"
      defaultHeight="590px"
      defaultTop="48px"
      defaultLeft="170px"
    >
      <ProjectsApp />
    </Window>

    <!-- 3. Experience & Career Window -->
    <Window
      id="win-experience"
      app="experience"
      title="Career History & Education — Document Viewer"
      iconSrc="/icons/app-experience.svg"
      menuItems={['File', 'Edit', 'View', 'Help']}
      statusText="Document: career_journal.log • 3 sections • UTF-8"
      defaultWidth="850px"
      defaultHeight="580px"
      defaultTop="54px"
      defaultLeft="190px"
    >
      <ExperienceApp />
    </Window>

    <!-- 4. Certifications (Ristretto) Window -->
    <Window
      id="win-certs"
      app="certs"
      title="credentials — Ristretto Image Viewer"
      iconSrc="/icons/app-certs.svg"
      menuItems={['File', 'Edit', 'View', 'Go', 'Help']}
      statusText="7 credentials loaded • 1920x1080 • PNG 24-bit"
      defaultWidth="860px"
      defaultHeight="600px"
      defaultTop="60px"
      defaultLeft="210px"
    >
      <CertsApp />
    </Window>

    <!-- 5. Terminal Window -->
    <Window
      id="win-terminal"
      app="terminal"
      title="mario@kali: ~ (qterminal)"
      iconSrc="/icons/app-terminal.svg"
      menuItems={['File', 'Edit', 'View', 'Session', 'Help']}
      statusText="Normal mode • Shell: /bin/zsh • PID: 4210"
      defaultWidth="800px"
      defaultHeight="500px"
      defaultTop="70px"
      defaultLeft="230px"
    >
      <TerminalApp />
    </Window>

    <!-- 6. Traceroute Map Window -->
    <Window
      id="win-map"
      app="map"
      title="traceroute — Network Path Diagnostic"
      iconSrc="/icons/app-map.svg"
      menuItems={['Trace', 'View', 'Tools', 'Help']}
      statusText="Route: Mexico -> Vancouver • Latency: 48ms • ICMP OK"
      defaultWidth="840px"
      defaultHeight="560px"
      defaultTop="80px"
      defaultLeft="250px"
    >
      <MapApp />
    </Window>

    <!-- 7. Security Writeups (Blog) Window -->
    <Window
      id="win-blog"
      app="blog"
      title="Security Advisories & Research — Reader"
      iconSrc="/icons/app-blog.svg"
      menuItems={['File', 'Edit', 'View', 'Go', 'Help']}
      statusText="6 publications • Source: medium.com/@mabarajam"
      defaultWidth="850px"
      defaultHeight="580px"
      defaultTop="65px"
      defaultLeft="180px"
    >
      <BlogApp />
    </Window>

    <!-- 8. Contact Window -->
    <Window
      id="win-contact"
      app="contact"
      title="Write: New Message — mario@kali"
      iconSrc="/icons/app-mail.svg"
      menuItems={['Message', 'Edit', 'View', 'Options', 'Help']}
      statusText="Encryption: TLS / ProtonMail • Vancouver, BC (PST)"
      defaultWidth="760px"
      defaultHeight="540px"
      defaultTop="85px"
      defaultLeft="260px"
    >
      <ContactApp />
    </Window>

    <!-- 9. Resume Window -->
    <Window
      id="win-resume"
      app="resume"
      title="Mario_Barajas_Resume.pdf — Document Viewer"
      iconSrc="/icons/app-pdf.svg"
      menuItems={['File', 'Edit', 'View', 'Go', 'Help']}
      statusText="1 page • Size: Letter • Evince Document Viewer"
      defaultWidth="840px"
      defaultHeight="600px"
      defaultTop="45px"
      defaultLeft="160px"
    >
      <ResumeApp />
    </Window>
  </main>

  <!-- Dock (Plank style) -->
  <Dock />
</div>

<script>
  // Authentic Window Manager State & Controller
  class KaliWindowManager {
    private topZ: number = 10;

    constructor() {
      this.initEvents();
      this.initClock();
      this.openInitialApp();
    }

    private openInitialApp() {
      const desktop = document.getElementById('kali-desktop');
      const initialApp = desktop?.getAttribute('data-initial-app') || 'about';
      this.openApp(initialApp);
    }

    private initClock() {
      const clockEl = document.getElementById('topbar-clock');
      if (!clockEl) return;
      const update = () => {
        const now = new Date();
        const opts: Intl.DateTimeFormatOptions = {
          weekday: 'short',
          month: 'short',
          day: 'numeric',
          hour: '2-digit',
          minute: '2-digit',
          second: '2-digit',
          hour12: false,
        };
        clockEl.innerText = now.toLocaleString('en-US', opts);
      };
      update();
      setInterval(update, 1000);
    }

    private initEvents() {
      // Dock item clicks / touches
      document.querySelectorAll('.dock-item[data-app]').forEach(btn => {
        const app = btn.getAttribute('data-app');
        if (!app) return;
        let lastDockTouch = 0;
        const trigger = (e: Event) => {
          const now = Date.now();
          if (now - lastDockTouch < 350) return;
          lastDockTouch = now;
          e.preventDefault();
          this.toggleApp(app);
        };
        btn.addEventListener('click', trigger);
        btn.addEventListener('touchend', trigger, { passive: false });
      });

      // Desktop icons click / touch
      document.querySelectorAll('.desktop-icon[data-app]').forEach(item => {
        const app = item.getAttribute('data-app');
        if (!app) return;
        let lastIconTouch = 0;
        const trigger = (e: Event) => {
          const now = Date.now();
          if (now - lastIconTouch < 350) return;
          lastIconTouch = now;
          e.preventDefault();
          this.openApp(app);
        };
        item.addEventListener('click', trigger);
        item.addEventListener('touchend', trigger, { passive: false });
      });

      // Window control buttons & header dragging
      document.querySelectorAll('.window').forEach(winEl => {
        const win = winEl as HTMLElement;
        const app = win.getAttribute('data-app') || '';

        // Focus on click/touch (ignore if touching window controls directly)
        const focusHandler = (e: Event) => {
          if ((e.target as HTMLElement).closest('.window-controls')) return;
          this.focusWindow(win);
        };
        win.addEventListener('pointerdown', focusHandler, { capture: true });
        win.addEventListener('mousedown', focusHandler, { capture: true });

        // Ensure outer window frame never scrolls internally
        win.addEventListener('scroll', () => {
          if (win.scrollTop !== 0) win.scrollTop = 0;
          if (win.scrollLeft !== 0) win.scrollLeft = 0;
        });

        // Window controls container: isolate touch and pointer events
        const controls = win.querySelector('.window-controls') as HTMLElement;
        if (controls) {
          controls.addEventListener('pointerdown', (e) => e.stopPropagation());
          controls.addEventListener('touchstart', (e) => e.stopPropagation());
          controls.addEventListener('mousedown', (e) => e.stopPropagation());
        }

        // Helper for reliable button actions on desktop and touchscreens
        const bindButtonAction = (btn: HTMLElement | null, action: () => void) => {
          if (!btn) return;
          let lastAction = 0;
          const trigger = (e: Event) => {
            const now = Date.now();
            if (now - lastAction < 350) return;
            lastAction = now;
            e.preventDefault();
            e.stopPropagation();
            action();
          };
          btn.addEventListener('touchend', trigger, { passive: false });
          btn.addEventListener('click', trigger);
        };

        // Close button
        const closeBtn = win.querySelector('.btn-close') as HTMLElement;
        bindButtonAction(closeBtn, () => this.closeApp(app));

        // Minimize button
        const minBtn = win.querySelector('.btn-minimize') as HTMLElement;
        bindButtonAction(minBtn, () => this.minimizeApp(app));

        // Maximize button
        const maxBtn = win.querySelector('.btn-maximize') as HTMLElement;
        bindButtonAction(maxBtn, () => this.toggleMaximize(win));

        // Header double click to toggle maximize
        const header = win.querySelector('.window-header') as HTMLElement;
        header?.addEventListener('dblclick', () => this.toggleMaximize(win));

        // Dragging logic
        this.makeDraggable(win, header);
      });

      // Listen for custom open-app events (from terminal or internal links)
      window.addEventListener('kali:open-app', (e: any) => {
        if (e.detail?.app) {
          this.openApp(e.detail.app);
        }
      });

      // Popstate navigation support
      window.addEventListener('popstate', () => {
        const path = window.location.pathname.replace(/^\/|\/$/g, '');
        if (path === '' || path === 'index') {
          this.openApp('about', false);
        } else if (['projects', 'experience', 'certs', 'blog', 'contact', 'map', 'terminal', 'resume'].includes(path)) {
          this.openApp(path, false);
        }
      });
    }

    public openApp(app: string, updateUrl = true) {
      const win = document.querySelector(`.window[data-app="${app}"]`) as HTMLElement;
      if (!win) return;

      win.classList.remove('is-minimized');
      win.classList.add('is-open');
      this.focusWindow(win);
      this.updateTopBarTabs();

      // Update Dock dot
      const dockBtn = document.querySelector(`.dock-item[data-app="${app}"]`);
      dockBtn?.classList.add('is-open');

      // Update Topbar active label
      const activeLabel = document.getElementById('topbar-active-app');
      const titleText = win.querySelector('.window-title-text')?.textContent || app;
      if (activeLabel) activeLabel.innerText = titleText;

      // Special notification for Map
      if (app === 'map') {
        window.dispatchEvent(new CustomEvent('kali:map-ready'));
      }

      // Sync URL if desired
      if (updateUrl && window.history.pushState) {
        const targetPath = app === 'about' ? '/' : `/${app}`;
        if (window.location.pathname !== targetPath) {
          window.history.pushState({ app }, '', targetPath);
        }
      }
    }

    public closeApp(app: string) {
      const win = document.querySelector(`.window[data-app="${app}"]`) as HTMLElement;
      if (!win) return;

      win.classList.remove('is-open', 'is-focused');

      // Update Dock dot
      const dockBtn = document.querySelector(`.dock-item[data-app="${app}"]`);
      dockBtn?.classList.remove('is-open');
      this.updateTopBarTabs();

      // If this was focused, focus next available window
      const openWins = Array.from(document.querySelectorAll('.window.is-open:not(.is-minimized)')) as HTMLElement[];
      if (openWins.length > 0) {
        this.focusWindow(openWins[openWins.length - 1]);
      } else {
        const activeLabel = document.getElementById('topbar-active-app');
        if (activeLabel) activeLabel.innerText = 'Kali Desktop';
        if (window.history.pushState && window.location.pathname !== '/') {
          window.history.pushState({}, '', '/');
        }
      }
    }

    public minimizeApp(app: string) {
      const win = document.querySelector(`.window[data-app="${app}"]`) as HTMLElement;
      if (!win) return;
      win.classList.add('is-minimized');
      win.classList.remove('is-focused');
      this.updateTopBarTabs();
    }

    public toggleApp(app: string) {
      const win = document.querySelector(`.window[data-app="${app}"]`) as HTMLElement;
      if (!win) return;

      if (!win.classList.contains('is-open')) {
        this.openApp(app);
      } else if (win.classList.contains('is-minimized')) {
        win.classList.remove('is-minimized');
        this.focusWindow(win);
      } else if (win.classList.contains('is-focused')) {
        this.minimizeApp(app);
      } else {
        this.focusWindow(win);
      }
    }

    public focusWindow(win: HTMLElement) {
      document.querySelectorAll('.window').forEach(w => w.classList.remove('is-focused'));
      this.topZ += 1;
      win.style.zIndex = `${this.topZ}`;
      win.classList.add('is-focused');
      this.updateTopBarTabs();

      const app = win.getAttribute('data-app');
      const activeLabel = document.getElementById('topbar-active-app');
      const titleText = win.querySelector('.window-title-text')?.textContent || app;
      if (activeLabel && titleText) activeLabel.innerText = titleText;

      // Auto-focus terminal input whenever terminal window is focused or opened
      if (app === 'terminal') {
        const termInput = win.querySelector('#terminal-cli-input') as HTMLInputElement | null;
        if (termInput) {
          setTimeout(() => {
            termInput.focus({ preventScroll: true });
          }, 50);
        }
      }
    }

    public updateTopBarTabs() {
      const container = document.getElementById("topbar-window-tabs");
      if (!container) return;

      const APP_SHORT_NAMES: Record<string, string> = {
        about: "System Profiler",
        projects: "projects",
        experience: "Career History",
        certs: "credentials",
        terminal: "Terminal",
        map: "traceroute",
        blog: "Writeups",
        contact: "Contact",
        resume: "Resume (PDF)",
      };

      const openWins = Array.from(document.querySelectorAll(".window.is-open")) as HTMLElement[];
      container.innerHTML = "";

      openWins.forEach(win => {
        const app = win.getAttribute("data-app") || "";
        const titleText = win.querySelector(".window-title-text")?.textContent || app;
        const shortLabel = APP_SHORT_NAMES[app] || titleText;
        const isFocused = win.classList.contains("is-focused");
        const isMinimized = win.classList.contains("is-minimized");

        const btn = document.createElement("button");
        btn.className = `topbar-taskbar-tab ${isFocused ? "active" : ""} ${isMinimized ? "minimized" : ""}`;
        btn.setAttribute("data-app", app);
        btn.setAttribute("title", `Switch to ${titleText}`);
        btn.innerHTML = `
          <span class="active-tab-dot"></span>
          <span class="tab-title">${shortLabel}</span>
        `;

        let lastTabTouch = 0;
        const triggerTab = (e: Event) => {
          const now = Date.now();
          if (now - lastTabTouch < 350) return;
          lastTabTouch = now;
          e.preventDefault();
          e.stopPropagation();
          this.toggleApp(app);
        };
        btn.addEventListener("click", triggerTab);
        btn.addEventListener("touchend", triggerTab, { passive: false });

        container.appendChild(btn);
      });
    }

    public toggleMaximize(win: HTMLElement) {
      win.classList.toggle('is-maximized');
      window.dispatchEvent(new CustomEvent('kali:window-resize'));
    }

    private makeDraggable(win: HTMLElement, handle: HTMLElement) {
      if (!handle) return;
      let isDragging = false;
      let startX = 0;
      let startY = 0;
      let initialLeft = 0;
      let initialTop = 0;

      handle.addEventListener('pointerdown', (e: PointerEvent) => {
        if (window.innerWidth <= 768) return; // Never drag on mobile
        if (win.classList.contains('is-maximized')) return;
        if ((e.target as HTMLElement).closest('.window-controls')) return;

        isDragging = true;
        startX = e.clientX;
        startY = e.clientY;

        const rect = win.getBoundingClientRect();
        initialLeft = rect.left;
        initialTop = rect.top;

        handle.setPointerCapture(e.pointerId);
      });

      handle.addEventListener('pointermove', (e: PointerEvent) => {
        if (!isDragging) return;
        const dx = e.clientX - startX;
        const dy = e.clientY - startY;

        let nextLeft = initialLeft + dx;
        let nextTop = initialTop + dy;

        // Boundaries: keep on screen
        nextTop = Math.max(30, nextTop); // Topbar height
        nextTop = Math.min(window.innerHeight - 60, nextTop);
        nextLeft = Math.max(-rectWidth(win) + 100, Math.min(window.innerWidth - 100, nextLeft));

        win.style.left = `${nextLeft}px`;
        win.style.top = `${nextTop}px`;
      });

      const stopDrag = (e: PointerEvent) => {
        if (!isDragging) return;
        isDragging = false;
        try { handle.releasePointerCapture(e.pointerId); } catch (_) {}
      };

      handle.addEventListener('pointerup', stopDrag);
      handle.addEventListener('pointercancel', stopDrag);

      function rectWidth(el: HTMLElement) {
        return el.offsetWidth || 300;
      }
    }
  }

  // Initialize
  let wm: KaliWindowManager | null = null;
  function startWM() {
    if (!wm) {
      wm = new KaliWindowManager();
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', startWM);
  } else {
    startWM();
  }
</script>
