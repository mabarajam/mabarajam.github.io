---
export interface Props {
  id: string;
  app: string;
  title: string;
  icon?: string;
  defaultWidth?: string;
  defaultHeight?: string;
  defaultTop?: string;
  defaultLeft?: string;
}

const {
  id,
  app,
  title,
  icon = 'fa-solid fa-window-maximize',
  defaultWidth = '800px',
  defaultHeight = '550px',
  defaultTop = '50px',
  defaultLeft = '180px',
} = Astro.props;
---

<div
  class="window"
  id={id}
  data-app={app}
  style={`width: ${defaultWidth}; height: ${defaultHeight}; top: ${defaultTop}; left: ${defaultLeft};`}
  role="dialog"
  aria-label={title}
>
  <div class="window-header">
    <div class="window-controls">
      <button class="window-control-btn btn-close" data-action="close" title="Close" aria-label="Close window">✕</button>
      <button class="window-control-btn btn-minimize" data-action="minimize" title="Minimize" aria-label="Minimize window">−</button>
      <button class="window-control-btn btn-maximize" data-action="maximize" title="Maximize" aria-label="Maximize window">＋</button>
    </div>

    <div class="window-title-group">
      <i class={`${icon} window-title-icon`}></i>
      <span class="window-title-text">{title}</span>
    </div>

    <div style="width: 52px;"></div> <!-- Spacer to center title balance -->
  </div>

  <div class="window-body">
    <slot />
  </div>
</div>
