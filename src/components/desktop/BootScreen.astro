---
// BootScreen.astro - Kali Linux boot sequence animation
---

<div class="boot-screen" id="kali-boot-screen">
  <div class="boot-log-view" id="boot-log-view">
    <div class="boot-log-line"><span class="boot-ok-badge">[  OK  ]</span><span>Started System Logging Service.</span></div>
    <div class="boot-log-line"><span class="boot-ok-badge">[  OK  ]</span><span>Mounted /home/mario/projects.</span></div>
    <div class="boot-log-line"><span class="boot-ok-badge">[  OK  ]</span><span>Loaded Certificates: CompTIA Security+ (SY0-701).</span></div>
    <div class="boot-log-line"><span class="boot-ok-badge">[  OK  ]</span><span>Initialized Splunk & Wazuh Threat Monitoring.</span></div>
    <div class="boot-log-line"><span class="boot-ok-badge">[  OK  ]</span><span>Connected node: Vancouver, BC (Current Base).</span></div>
    <div class="boot-log-line"><span class="boot-ok-badge">[  OK  ]</span><span>Starting Kali Desktop Environment...</span></div>
    <div class="boot-log-line"><span class="boot-ok-badge">[  OK  ]</span><span>Reached target Graphical Interface.</span></div>
  </div>

  <div class="boot-splash-view" id="boot-splash-view" style="display: none;">
    <img src="/brand/kali-dragon-icon.svg" alt="Kali Linux" class="boot-logo" />
    <div class="boot-title">KALI LINUX • MARIO BARAJAS</div>
    <div class="boot-progressbar-outer">
      <div class="boot-progressbar-inner" id="boot-progress-bar"></div>
    </div>
    <div class="boot-skip-hint">Press any key or click anywhere to skip</div>
  </div>
</div>

<script>
  function initBootScreen() {
    const screen = document.getElementById('kali-boot-screen');
    const logView = document.getElementById('boot-log-view');
    const splashView = document.getElementById('boot-splash-view');
    const progressBar = document.getElementById('boot-progress-bar');
    if (!screen) return;

    // Check if previously booted in this session, or direct deep-link or reduced motion
    const hasBooted = sessionStorage.getItem('mario_kali_booted');
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const isDeepLink = window.location.pathname !== '/' && window.location.pathname !== '';

    if (hasBooted || prefersReducedMotion || isDeepLink) {
      screen.style.display = 'none';
      return;
    }

    sessionStorage.setItem('mario_kali_booted', 'true');

    let finished = false;
    const dismiss = () => {
      if (finished) return;
      finished = true;
      screen.classList.add('fade-out');
      setTimeout(() => {
        screen.style.display = 'none';
      }, 500);
    };

    // User can click or press any key to skip
    window.addEventListener('keydown', dismiss, { once: true });
    screen.addEventListener('click', dismiss, { once: true });

    // Step 1: Display logs for 600ms, then switch to splash
    setTimeout(() => {
      if (finished) return;
      if (logView) logView.style.display = 'none';
      if (splashView) splashView.style.display = 'flex';

      // Step 2: Animate progress bar to 100%
      setTimeout(() => {
        if (progressBar) progressBar.style.width = '100%';
      }, 50);

      // Step 3: Complete and fade out
      setTimeout(() => {
        dismiss();
      }, 900);
    }, 700);
  }

  // Run on page load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initBootScreen);
  } else {
    initBootScreen();
  }
</script>
