---
// BootScreen.astro - Kali Linux boot sequence animation
---

<div class="boot-screen" id="kali-boot-screen">
  <div class="boot-splash-view" id="boot-splash-view">
    <div class="boot-logo-wrapper">
      <img src="/brand/kali-dragon-icon.svg" alt="Kali Linux Dragon" class="boot-logo" />
      <div class="boot-logo-glow"></div>
    </div>
    
    <div class="boot-title-group">
      <div class="boot-title">KALI LINUX • 2026.3</div>
      <div class="boot-subtitle">MARIO BARAJAS | CYBERSECURITY WORKSTATION</div>
    </div>

    <div class="boot-progressbar-outer">
      <div class="boot-progressbar-inner" id="boot-progress-bar"></div>
    </div>

    <div class="boot-status-line" id="boot-status-text">
      <span class="boot-ok-badge">[  OK  ]</span> Loading security modules...
    </div>

    <div class="boot-skip-hint">Tap anywhere to skip</div>
  </div>
</div>

<script>
  function initBootScreen() {
    const screen = document.getElementById('kali-boot-screen');
    const progressBar = document.getElementById('boot-progress-bar');
    const statusText = document.getElementById('boot-status-text');
    if (!screen) return;

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReducedMotion) {
      screen.style.display = 'none';
      return;
    }

    let finished = false;
    const dismiss = () => {
      if (finished) return;
      finished = true;
      screen.classList.add('fade-out');
      setTimeout(() => {
        screen.style.display = 'none';
      }, 350);
    };

    // Skip on key or click/tap
    window.addEventListener('keydown', dismiss, { once: true });
    screen.addEventListener('click', dismiss, { once: true });
    screen.addEventListener('touchend', dismiss, { once: true });

    // Animated boot sequence
    const steps = [
      { progress: '30%', text: '<span class="boot-ok-badge">[  OK  ]</span> Initializing system kernel & network stack...' },
      { progress: '60%', text: '<span class="boot-ok-badge">[  OK  ]</span> Starting Wazuh & Splunk threat monitoring...' },
      { progress: '85%', text: '<span class="boot-ok-badge">[  OK  ]</span> Loading CompTIA Security+ verified credentials...' },
      { progress: '100%', text: '<span class="boot-ok-badge">[  OK  ]</span> Starting Kali Desktop Environment...' }
    ];

    setTimeout(() => {
      if (progressBar) progressBar.style.width = steps[0].progress;
      if (statusText) statusText.innerHTML = steps[0].text;
    }, 120);

    setTimeout(() => {
      if (progressBar) progressBar.style.width = steps[1].progress;
      if (statusText) statusText.innerHTML = steps[1].text;
    }, 450);

    setTimeout(() => {
      if (progressBar) progressBar.style.width = steps[2].progress;
      if (statusText) statusText.innerHTML = steps[2].text;
    }, 800);

    setTimeout(() => {
      if (progressBar) progressBar.style.width = steps[3].progress;
      if (statusText) statusText.innerHTML = steps[3].text;
    }, 1150);

    setTimeout(() => {
      dismiss();
    }, 1450);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initBootScreen);
  } else {
    initBootScreen();
  }
</script>
