---
import '../styles/main.css';

export interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Mario Barajas | Cybersecurity Analyst',
  description = 'Cybersecurity Analyst portfolio — threat detection, SIEM monitoring, vulnerability assessment, and offensive security labs in Vancouver, BC.'
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />

  <!-- Open Graph / Meta -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content="/brand/kali-dragon-icon.svg" />
  <meta name="theme-color" content="#0b0e14" />
  <link rel="icon" type="image/svg+xml" href="/brand/kali-dragon-icon.svg" />

  <!-- External Styles -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <link rel="stylesheet" href="https://unpkg.com/maplibre-gl@5.0.0/dist/maplibre-gl.css" />
</head>

<body>
  <slot />
</body>
</html>
