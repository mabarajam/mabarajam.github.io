---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact | Mario Barajas" description="Contact Mario Barajas - Cybersecurity Analyst based in Vancouver, BC.">

  <section id="contact" style="text-align: center; margin-top: var(--spacing-lg);">
    <p>> Initiating connection sequence...</p>
    <h2 style="font-size: 2rem; margin: var(--spacing-sm) 0;">Let's Connect</h2>
    <p>
      <span class="secure-email" data-email="Defensium@protonmail.com"
        style="cursor: pointer; color: var(--alert); border-bottom: 1px dashed var(--alert);">[CLICK_TO_DECRYPT_EMAIL]</span>
    </p>
    <div style="margin-top: var(--spacing-md);">
      <button class="secure-email-btn" data-email="Defensium@protonmail.com"
        style="background: transparent; border: 1px solid var(--link); padding: 10px 20px; color: var(--link); margin: 0 10px; cursor: pointer; font-family: inherit; font-size: inherit;">Initialize Email Protocol</button>
      <a href="/resume.pdf" download="Mario_Barajas_Resume.pdf"
        style="border: 1px solid var(--text-primary); padding: 10px 20px; color: var(--text-primary); margin: 0 10px; text-decoration: none;">Download Resume</a>
    </div>

    <div class="social-grid" style="margin-top: var(--spacing-md); display: flex; justify-content: center; gap: 20px; flex-wrap: wrap;">
      <a href="https://www.linkedin.com/in/marioabarajas/" target="_blank" class="social-link"
        style="color: var(--text-dim); text-decoration: none; font-size: 1.2rem; transition: all 0.3s;">
        [ <i class="fab fa-linkedin"></i> LINKEDIN ]
      </a>
      <a href="https://medium.com/@mabarajam" target="_blank" class="social-link"
        style="color: var(--text-dim); text-decoration: none; font-size: 1.2rem; transition: all 0.3s;">
        [ <i class="fab fa-medium"></i> MEDIUM ]
      </a>
      <a href="https://github.com/mabarajam" target="_blank" class="social-link"
        style="color: var(--text-dim); text-decoration: none; font-size: 1.2rem; transition: all 0.3s;">
        [ <i class="fab fa-github"></i> GITHUB ]
      </a>
    </div>
  </section>

</Layout>

<script>
  document.querySelectorAll('.secure-email').forEach(element => {
    element.addEventListener('click', function () {
      const originalText = "[CLICK_TO_DECRYPT_EMAIL]";
      const email = this.getAttribute('data-email');
      const isCurrentlyRevealed = this.innerText === email;
      const targetText = isCurrentlyRevealed ? originalText : email;
      let iterations = 0;
      const interval = setInterval(() => {
        this.innerText = this.innerText.split('').map((letter, index) => {
          if (index < iterations) return targetText[index];
          return String.fromCharCode(65 + Math.floor(Math.random() * 26));
        }).join('');
        if (iterations >= targetText.length) {
          clearInterval(interval);
          this.innerText = targetText;
          if (isCurrentlyRevealed) {
            this.style.color = "var(--alert)";
            this.style.borderBottom = "1px dashed var(--alert)";
          } else {
            this.style.color = "var(--text-primary)";
            this.style.borderBottom = "none";
          }
        }
        iterations += 1 / 3;
      }, 30);
    });
  });

  document.querySelectorAll('.secure-email-btn').forEach(btn => {
    btn.addEventListener('click', function () {
      window.location.href = `mailto:${this.getAttribute('data-email')}`;
    });
  });
</script>
