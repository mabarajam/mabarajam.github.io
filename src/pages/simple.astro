---
import Layout from '../layouts/Layout.astro';
import { profile, skillGroups, tools, trademarkNotice } from '../data/profile';
import { projects } from '../data/projects';
import { relevantExperience, pastCareers, educationList, certificationsList } from '../data/experience';
import { certificates } from '../data/certs';
import { mediumPosts } from '../data/mediumPosts';
---

<Layout
  title="Mario Barajas | Cybersecurity Analyst (Simple View)"
  description="Clean, recruiter-friendly view of Mario Barajas's cybersecurity portfolio, projects, work experience, and certifications."
>
  <div class="simple-page">
    <!-- Sticky Header Nav -->
    <header class="simple-header">
      <div class="simple-header-inner">
        <a href="#about" class="simple-brand">
          <img src="/brand/kali-dragon-icon.svg" alt="Kali" class="simple-brand-logo" />
          <div>
            <div class="simple-brand-name">Mario Barajas</div>
            <div class="simple-brand-role">Cybersecurity Analyst</div>
          </div>
        </a>

        <nav class="simple-nav">
          <a href="#about">About</a>
          <a href="#skills">Skills</a>
          <a href="#projects">Projects</a>
          <a href="#experience">Experience</a>
          <a href="#certs">Certifications</a>
          <a href="#route">Route</a>
          <a href="#contact">Contact</a>
        </nav>

        <div class="simple-header-actions">
          <a href="/" class="btn-desktop-switch" title="Launch interactive Kali Linux desktop environment">
            <i class="fa-solid fa-desktop"></i>
            <span>Kali Desktop</span>
          </a>
          <a href="/resume.pdf" download={profile.resumeFileName} class="btn-resume-download" title="Download resume PDF">
            <i class="fa-solid fa-download"></i>
            <span>Resume</span>
          </a>
        </div>
      </div>
    </header>

    <main class="simple-container">
      <!-- 1. Hero / About Section -->
      <section id="about" class="simple-section">
        <div class="simple-hero-card">
          <div class="simple-status-badge">
            <span class="status-indicator-dot"></span>
            <span>Open to SOC Analyst & Security Roles • Vancouver, BC</span>
          </div>

          <h1 class="simple-hero-title">Mario Barajas</h1>
          <p class="simple-hero-subtitle">
            Cybersecurity Analyst • CompTIA Security+ (SY0-701) • Threat Detection & SIEM
          </p>

          <div class="simple-bio-box">
            {profile.bio.map(p => (
              <p>{p}</p>
            ))}
          </div>

          <div class="simple-hero-links">
            <a href={`mailto:${profile.email}`} class="btn-simple-cta">
              <i class="fa-solid fa-paper-plane"></i>
              <span>Get in Touch</span>
            </a>
            <a href="/resume.pdf" download={profile.resumeFileName} class="btn-simple-cta secondary">
              <i class="fa-solid fa-file-pdf"></i>
              <span>Download Resume</span>
            </a>
            {profile.socials.map(s => (
              <a href={s.url} target="_blank" rel="noopener" class="btn-simple-social">
                <i class={s.icon}></i>
                <span>{s.label}</span>
              </a>
            ))}
          </div>
        </div>
      </section>

      <!-- 2. Skills & Tools Section -->
      <section id="skills" class="simple-section">
        <h2 class="simple-section-title">
          <i class="fa-solid fa-microchip"></i>
          <span>Technical Skills & Competencies</span>
        </h2>

        <div class="skills-grid">
          {skillGroups.map(group => (
            <div class="skill-card">
              <h3 class="skill-card-title">{group.title}</h3>
              <ul class="skill-list">
                {group.items.map(item => (
                  <li class="skill-item">
                    <span class="skill-bullet">></span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>

        <div class="simple-tools-card">
          <h3 style="font-size: 0.88rem; color: var(--text-muted); margin-bottom: 8px; font-weight: 600;">
            <i class="fa-solid fa-wrench" style="color: var(--kali-cyan); margin-right: 6px;"></i>
            Hands-on Security Tools & Frameworks:
          </h3>
          <div class="tools-wrap">
            {tools.map(tool => (
              <span class="tool-chip">{tool}</span>
            ))}
          </div>
        </div>
      </section>

      <!-- 3. Projects & Labs Section -->
      <section id="projects" class="simple-section">
        <div style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 16px; flex-wrap: wrap; gap: 8px;">
          <h2 class="simple-section-title" style="margin-bottom: 0;">
            <i class="fa-solid fa-folder-open"></i>
            <span>Featured Security Projects & Labs</span>
          </h2>
          <span style="font-size: 0.8rem; color: var(--text-dim); font-family: var(--font-mono);">
            5 Projects • Live Labs & Writeups
          </span>
        </div>

        <div class="projects-grid">
          {projects.map(proj => (
            <article class="project-card">
              <div class="project-card-header">
                <div class="project-card-icon">
                  <i class={proj.icon}></i>
                </div>
                {proj.badge && <span class="project-badge">{proj.badge}</span>}
              </div>

              <h3 class="project-card-title">{proj.title}</h3>
              {proj.summary && <p class="project-card-summary">{proj.summary}</p>}

              <ul class="project-card-bullets">
                {proj.bullets.map(bullet => (
                  <li class="project-bullet-item">{bullet}</li>
                ))}
              </ul>

              <div class="project-tags">
                {proj.tags.map(tag => (
                  <span class="project-tag">{tag}</span>
                ))}
              </div>

              {proj.links && proj.links.length > 0 && (
                <div class="project-links">
                  {proj.links.map(link => (
                    <a
                      href={link.url}
                      target={link.external ? '_blank' : '_self'}
                      rel={link.external ? 'noopener' : ''}
                      class={`btn-project ${link.label.includes('Medium') ? 'secondary' : ''}`}
                    >
                      {link.label.includes('Exam') && <i class="fa-solid fa-play"></i>}
                      {link.label.includes('Walkthrough') && <i class="fa-solid fa-book-open"></i>}
                      {link.label.includes('Medium') && <i class="fa-brands fa-medium"></i>}
                      <span>{link.label}</span>
                    </a>
                  ))}
                </div>
              )}
            </article>
          ))}
        </div>
      </section>

      <!-- 4. Work Experience Section -->
      <section id="experience" class="simple-section">
        <h2 class="simple-section-title">
          <i class="fa-solid fa-briefcase"></i>
          <span>Professional Experience</span>
        </h2>

        <div class="timeline" style="margin-bottom: 24px;">
          {relevantExperience.map(exp => (
            <div class="timeline-item">
              <div class="timeline-dot"></div>
              <div class="timeline-content">
                <h3 class="timeline-role">{exp.role}</h3>
                <div class="timeline-meta">{exp.company} ({exp.location}) | {exp.period}</div>
                <ul class="timeline-bullets">
                  {exp.bullets.map(b => (
                    <li class="timeline-bullet">{b}</li>
                  ))}
                </ul>
              </div>
            </div>
          ))}
        </div>

        <h3 style="font-size: 0.95rem; font-weight: 700; color: var(--text-muted); margin-bottom: 14px;">
          Previous Career Experience
        </h3>
        <div class="timeline">
          {pastCareers.map(exp => (
            <div class="timeline-item">
              <div class="timeline-dot" style="border-color: var(--color-purple);"></div>
              <div class="timeline-content">
                <h4 class="timeline-role" style="font-size: 0.95rem;">{exp.role}</h4>
                <div class="timeline-meta">{exp.company} ({exp.location}) | {exp.period}</div>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- 5. Education & Certifications Section -->
      <section id="education" class="simple-section">
        <h2 class="simple-section-title">
          <i class="fa-solid fa-graduation-cap"></i>
          <span>Education & Credentials</span>
        </h2>

        <div class="timeline" style="margin-bottom: 24px;">
          {educationList.map(edu => (
            <div class="timeline-item">
              <div class="timeline-dot" style="border-color: var(--color-yellow);"></div>
              <div class="timeline-content">
                <h3 class="timeline-role" style="font-size: 0.95rem;">{edu.degree}</h3>
                <div class="timeline-meta">{edu.school} ({edu.location}) | {edu.year}</div>
                {edu.coursework && (
                  <p style="font-size: 0.84rem; color: var(--text-muted); margin-top: 4px;">
                    <strong style="color: var(--text-secondary);">Coursework covering:</strong> {edu.coursework}
                  </p>
                )}
              </div>
            </div>
          ))}
        </div>

        <h3 style="font-size: 0.95rem; font-weight: 700; color: var(--color-green); margin-bottom: 12px;">
          Active Certifications
        </h3>
        <div class="timeline">
          {certificationsList.map(cert => (
            <div class="timeline-item">
              <div class="timeline-dot" style="border-color: var(--color-green);"></div>
              <div class="timeline-content">
                <h4 class="timeline-role" style="font-size: 0.95rem;">{cert.name}</h4>
                <div class="timeline-meta">{cert.issuer} | {cert.year}</div>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- 6. Certificates Gallery Section -->
      <section id="certs" class="simple-section">
        <h2 class="simple-section-title">
          <i class="fa-solid fa-certificate"></i>
          <span>Credential Badges & Certificates (7)</span>
        </h2>
        <p style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 16px;">
          Click any certificate to view high-resolution credential verification.
        </p>

        <div class="certs-grid">
          {certificates.map((cert, index) => (
            <div class="cert-card-item simple-cert-card" data-index={index} data-src={cert.image} data-caption={cert.caption}>
              <img src={cert.image} alt={cert.title} class="cert-thumb-img" loading="lazy" />
              <span class="cert-card-label">{cert.title}</span>
            </div>
          ))}
        </div>
      </section>

      <!-- 7. Interactive Route Map Section -->
      <section id="route" class="simple-section">
        <h2 class="simple-section-title">
          <i class="fa-solid fa-map-location-dot"></i>
          <span>Global Route & Locations</span>
        </h2>

        <div style="height: 380px; border-radius: var(--radius-md); overflow: hidden; border: 1px solid var(--border-subtle); position: relative;">
          <div id="map" style="width: 100%; height: 100%;"></div>
        </div>

        <div style="margin-top: 10px; font-size: 0.82rem; color: var(--text-muted); display: flex; justify-content: space-between;">
          <span>Origin: Aguascalientes, MX &rarr; Current Base: Vancouver, BC</span>
          <span style="color: var(--color-green); font-family: var(--font-mono); font-weight: 600;">ACTIVE CONNECTION</span>
        </div>
      </section>

      <!-- 8. Publications & Writeups -->
      <section id="blog-posts" class="simple-section">
        <h2 class="simple-section-title">
          <i class="fa-solid fa-newspaper"></i>
          <span>Articles & Writeups on Medium</span>
        </h2>

        <div class="blog-list">
          {mediumPosts.map(post => (
            <article class="blog-card">
              <div class="blog-card-header">
                <span class="blog-source-badge">
                  <i class="fa-brands fa-medium"></i> MEDIUM
                </span>
                <span class="blog-card-date">{post.date}</span>
              </div>
              <h3 class="blog-card-title">
                <a href={post.url} target="_blank" rel="noopener" style="color: #fff;">{post.title}</a>
              </h3>
              <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 6px;">
                <div style="display: flex; gap: 6px; flex-wrap: wrap;">
                  {post.tags.map(t => <span class="project-tag">#{t}</span>)}
                </div>
                <a href={post.url} target="_blank" rel="noopener" class="btn-project secondary" style="font-size: 0.76rem;">
                  <span>Read Article</span>
                  <i class="fa-solid fa-arrow-up-right-from-square"></i>
                </a>
              </div>
            </article>
          ))}
        </div>
      </section>

      <!-- 9. Contact Section -->
      <section id="contact" class="simple-section">
        <div class="contact-hero-card">
          <h2 style="font-size: 1.3rem; font-weight: 700; color: #fff;">Connect with Mario Barajas</h2>
          <p style="font-size: 0.88rem; color: var(--text-muted); margin-top: 4px;">
            Let's discuss cybersecurity analyst opportunities, threat defense, or security assessments.
          </p>

          <div class="contact-email-box">
            <span id="simple-email-display">{profile.email}</span>
            <div style="display: flex; gap: 8px;">
              <button class="btn-copy-email" id="simple-copy-email-btn">
                <i class="fa-regular fa-copy"></i>
                <span id="simple-copy-btn-text">Copy</span>
              </button>
              <a href={`mailto:${profile.email}`} class="btn-copy-email" style="background: var(--kali-gradient);">
                <i class="fa-solid fa-paper-plane"></i>
                <span>Email</span>
              </a>
            </div>
          </div>

          <div style="display: flex; justify-content: center; gap: 12px; margin-top: 16px; flex-wrap: wrap;">
            <a href="/resume.pdf" download={profile.resumeFileName} class="btn-social" style="background: var(--kali-gradient); border-color: transparent;">
              <i class="fa-solid fa-download"></i>
              <span>Download Resume</span>
            </a>
            {profile.socials.map(s => (
              <a href={s.url} target="_blank" rel="noopener" class="btn-social">
                <i class={s.icon}></i>
                <span>{s.label}</span>
              </a>
            ))}
          </div>
        </div>
      </section>

      <!-- Trademark Disclaimer -->
      <footer class="simple-footer">
        <p>&copy; 2026 Mario Barajas. All rights reserved.</p>
        <p class="trademark-notice" style="margin-top: 8px;">{trademarkNotice}</p>
      </footer>
    </main>
  </div>

  <!-- Certificate Lightbox Modal Overlay (shared across pages) -->
  <div class="cert-lightbox-modal" id="kali-cert-modal" role="dialog" aria-label="Certificate Image Viewer">
    <button class="cert-modal-close" id="cert-modal-close" aria-label="Close viewer">✕</button>
    <button class="cert-modal-nav prev" id="cert-modal-prev" aria-label="Previous certificate"><i class="fa-solid fa-chevron-left"></i></button>
    <button class="cert-modal-nav next" id="cert-modal-next" aria-label="Next certificate"><i class="fa-solid fa-chevron-right"></i></button>
    <div class="cert-modal-content">
      <img id="cert-modal-img" class="cert-modal-img" src="" alt="Certificate View" />
      <div id="cert-modal-caption" class="cert-modal-caption"></div>
    </div>
  </div>
</Layout>

<script>
  import maplibregl from 'maplibre-gl';
  import * as turf from '@turf/turf';

  // Map Setup
  function initSimpleMap() {
    const mapEl = document.getElementById('map');
    if (!mapEl) return;

    const map = new maplibregl.Map({
      container: 'map',
      style: {
        version: 8,
        sources: {
          'dark-matter': {
            type: 'raster',
            tiles: [
              'https://a.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}.png',
              'https://b.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}.png',
            ],
            tileSize: 256,
          },
        },
        layers: [{ id: 'dark-matter-layer', type: 'raster', source: 'dark-matter', minzoom: 0, maxzoom: 22 }],
      },
      center: [-110, 36],
      zoom: 2.8,
    });

    const locations = [
      { name: 'Vancouver, BC', coords: [-123.1207, 49.2827] as [number, number], desc: 'Current Base | Cybersecurity Operations' },
      { name: 'Aguascalientes, MX', coords: [-102.2916, 21.8853] as [number, number], desc: 'Origin | Education & Early Career' },
    ];

    locations.forEach(loc => {
      const el = document.createElement('div');
      el.className = 'marker';
      new maplibregl.Marker({ element: el })
        .setLngLat(loc.coords)
        .setPopup(new maplibregl.Popup({ offset: 20 }).setHTML(`<h3>${loc.name}</h3><p>${loc.desc}</p>`))
        .addTo(map);
    });

    map.on('load', () => {
      const origin: [number, number] = [-102.2916, 21.8853];
      const destination: [number, number] = [-123.1207, 49.2827];
      const route = turf.greatCircle(turf.point(origin), turf.point(destination));

      map.addSource('route', { type: 'geojson', data: route });
      map.addLayer({
        id: 'route-line',
        type: 'line',
        source: 'route',
        layout: { 'line-join': 'round', 'line-cap': 'round' },
        paint: { 'line-color': '#23bac2', 'line-width': 2.5, 'line-opacity': 0.7 },
      });

      map.addSource('comet', { type: 'geojson', data: turf.point(origin) });
      map.addLayer({
        id: 'comet-layer',
        type: 'circle',
        source: 'comet',
        paint: {
          'circle-radius': 5,
          'circle-color': '#f43f5e',
          'circle-blur': 0.1,
          'circle-stroke-width': 3,
          'circle-stroke-color': 'rgba(244, 63, 94, 0.5)',
        },
      });

      const arcLength = turf.length(route, { units: 'kilometers' });
      const steps = 300;
      let counter = 0;
      function animateComet() {
        counter += 1;
        if (counter >= steps) counter = 0;
        const distance = (counter / steps) * arcLength;
        const currentPoint = turf.along(route, distance, { units: 'kilometers' });
        const cometSrc: any = map.getSource('comet');
        if (cometSrc) cometSrc.setData(currentPoint);
        requestAnimationFrame(animateComet);
      }
      animateComet();
    });

    map.addControl(new maplibregl.NavigationControl(), 'top-right');
  }

  // Lightbox Setup
  function initSimpleLightbox() {
    const modal = document.getElementById('kali-cert-modal');
    const modalImg = document.getElementById('cert-modal-img') as HTMLImageElement;
    const captionText = document.getElementById('cert-modal-caption');
    const closeBtn = document.getElementById('cert-modal-close');
    const prevBtn = document.getElementById('cert-modal-prev');
    const nextBtn = document.getElementById('cert-modal-next');
    const cards = Array.from(document.querySelectorAll('.simple-cert-card'));

    if (!modal || !modalImg || !captionText || cards.length === 0) return;

    let currentIndex = 0;
    const displayCert = (idx: number) => {
      currentIndex = (idx + cards.length) % cards.length;
      const card = cards[currentIndex];
      if (!card) return;
      modalImg.style.opacity = '0';
      setTimeout(() => {
        modalImg.src = card.getAttribute('data-src') || '';
        captionText.innerText = card.getAttribute('data-caption') || '';
        modalImg.style.opacity = '1';
      }, 100);
    };

    cards.forEach((card, idx) => {
      card.addEventListener('click', () => {
        modal.classList.add('active');
        displayCert(idx);
      });
    });

    const closeLightbox = () => modal.classList.remove('active');
    closeBtn?.addEventListener('click', closeLightbox);
    prevBtn?.addEventListener('click', (e) => { e.stopPropagation(); displayCert(currentIndex - 1); });
    nextBtn?.addEventListener('click', (e) => { e.stopPropagation(); displayCert(currentIndex + 1); });
    modal.addEventListener('click', (e) => { if (e.target === modal) closeLightbox(); });

    document.addEventListener('keydown', (e) => {
      if (!modal.classList.contains('active')) return;
      if (e.key === 'Escape') closeLightbox();
      if (e.key === 'ArrowLeft') displayCert(currentIndex - 1);
      if (e.key === 'ArrowRight') displayCert(currentIndex + 1);
    });
  }

  // Copy email
  function initCopyEmail() {
    const btn = document.getElementById('simple-copy-email-btn');
    const txt = document.getElementById('simple-copy-btn-text');
    const disp = document.getElementById('simple-email-display');
    if (!btn || !txt || !disp) return;

    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(disp.innerText.trim());
        txt.innerText = 'Copied!';
        setTimeout(() => { txt.innerText = 'Copy'; }, 2000);
      } catch (e) {}
    });
  }

  initSimpleMap();
  initSimpleLightbox();
  initCopyEmail();
</script>

<style>
  .simple-page {
    min-height: 100vh;
    background: #0b0e14;
    color: var(--text-primary);
    overflow-y: auto;
  }

  .simple-header {
    position: sticky;
    top: 0;
    background: rgba(14, 18, 27, 0.95);
    backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--border-subtle);
    z-index: 1000;
  }

  .simple-header-inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 10px 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .simple-brand {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: #fff;
  }

  .simple-brand-logo {
    width: 28px;
    height: 28px;
    filter: drop-shadow(0 0 6px rgba(35, 186, 194, 0.5));
  }

  .simple-brand-name {
    font-size: 0.95rem;
    font-weight: 700;
  }

  .simple-brand-role {
    font-size: 0.72rem;
    color: var(--kali-cyan);
  }

  .simple-nav {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .simple-nav a {
    color: var(--text-secondary);
    font-size: 0.82rem;
    font-weight: 500;
    transition: color 0.2s;
  }

  .simple-nav a:hover {
    color: var(--kali-cyan);
  }

  .simple-header-actions {
    display: flex;
    gap: 8px;
  }

  .btn-desktop-switch {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 14px;
    border-radius: 20px;
    background: var(--kali-gradient);
    color: #fff;
    font-size: 0.78rem;
    font-weight: 600;
    box-shadow: 0 0 12px rgba(35, 186, 194, 0.4);
    transition: transform 0.15s, opacity 0.15s;
  }

  .btn-desktop-switch:hover {
    transform: translateY(-1px);
    opacity: 0.95;
    color: #fff;
  }

  .btn-resume-download {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    border-radius: 20px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid var(--border-subtle);
    color: var(--text-primary);
    font-size: 0.78rem;
    font-weight: 500;
  }

  .btn-resume-download:hover {
    background: rgba(255, 255, 255, 0.15);
    color: #fff;
  }

  .simple-container {
    max-width: 1040px;
    margin: 0 auto;
    padding: 40px 20px 80px;
  }

  .simple-section {
    margin-bottom: 56px;
  }

  .simple-section-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: #fff;
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 18px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--border-subtle);
  }

  .simple-section-title i {
    color: var(--kali-cyan);
  }

  .simple-hero-card {
    background: rgba(18, 24, 38, 0.85);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: 36px;
    box-shadow: var(--shadow-window);
  }

  .simple-status-badge {
    display: inline-flex;
    align-items: center;
