---
import Layout from '../layouts/Layout.astro';
import { profile, skillGroups, tools } from '../data/profile';
import { projects } from '../data/projects';
import { relevantExperience, pastCareers, educationList, certificationsList } from '../data/experience';
import { certificates } from '../data/certs';
import { mediumPosts } from '../data/mediumPosts';
---

<Layout
  title="Mario Barajas | Cybersecurity Analyst (Simple View)"
  description="Clean, recruiter-friendly view of Mario Barajas's cybersecurity portfolio, projects, work experience, and certifications."
>
  <div class="simple-page-wrapper">
    <!-- Sticky Header Nav -->
    <header class="simple-header">
      <div class="simple-header-inner">
        <a href="#about" class="simple-brand">
          <img src="/brand/kali-dragon-icon.svg" alt="Kali Dragon" class="simple-brand-logo" width="22" height="22" />
          <span class="simple-brand-name">Mario Barajas</span>
          <span class="simple-brand-role">Cybersecurity Analyst</span>
        </a>

        <nav class="simple-nav" aria-label="Simple View Navigation">
          <a href="#about">About</a>
          <a href="#projects">Projects</a>
          <a href="#experience">Experience</a>
          <a href="#credentials">Credentials</a>
          <a href="#network-route">Traceroute</a>
          <a href="#writeups">Writeups</a>
          <a href="#contact">Contact</a>
        </nav>

        <div class="simple-header-actions">
          <a href="/" class="btn-desktop-switch" title="Switch to Kali Linux Interactive Desktop">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect><line x1="8" y1="21" x2="16" y2="21"></line><line x1="12" y1="17" x2="12" y2="21"></line></svg>
            <span>Kali Desktop View</span>
          </a>
          <a href="/resume.pdf" download={profile.resumeFileName} class="btn-resume-download" title="Download Resume PDF">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
            <span>Resume (PDF)</span>
          </a>
        </div>
      </div>
    </header>

    <!-- Main Scrollable Content -->
    <main class="simple-container">
      <!-- 1. Hero / About Summary -->
      <section id="about" class="simple-section">
        <div class="simple-hero-card">
          <div class="simple-status-badge">
            <span class="status-indicator-dot"></span>
            <span>AVAILABLE FOR SOC & CYBERSECURITY ANALYST ROLES • VANCOUVER, BC / REMOTE</span>
          </div>

          <h1 class="simple-hero-title">Mario Barajas</h1>
          <p class="simple-hero-subtitle">Cybersecurity Analyst | CompTIA Security+ (SY0-701)</p>

          <div class="simple-bio-box">
            {profile.bio.map(p => (
              <p>{p}</p>
            ))}
          </div>

          <div class="simple-hero-links">
            <a href={`mailto:${profile.email}`} class="btn-simple-cta">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg>
              <span>Contact: {profile.email}</span>
            </a>
            <a href="/resume.pdf" download={profile.resumeFileName} class="btn-simple-cta secondary">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
              <span>Download Resume</span>
            </a>
            {profile.socials.map(s => (
              <a href={s.url} target="_blank" rel="noopener" class="btn-simple-social">
                <span>{s.label}</span>
                <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
              </a>
            ))}
          </div>

          <!-- Tools Installed -->
          <div class="simple-tools-card">
            <div style="font-size: 0.76rem; font-family: var(--font-mono); color: #717d93; margin-bottom: 8px;">
              CORE SECURITY TOOLS & ENVIRONMENTS:
            </div>
            <div style="display: flex; gap: 6px; flex-wrap: wrap;">
              {tools.map(tool => (
                <span class="gtk-tag-pill" style="color: #61afef; border-color: #283142;">{tool}</span>
              ))}
            </div>
          </div>
        </div>
      </section>

      <!-- 2. Technical Competencies -->
      <section class="simple-section">
        <h2 class="simple-section-title">
          <span class="sec-title-icon">[+]</span> Technical Competencies & Frameworks
        </h2>

        <div class="gtk-table-grid">
          {skillGroups.map(group => (
            <div class="gtk-table-column">
              <div class="gtk-column-header">
                <span style="color: #38bdf8;">[+]</span> {group.title}
              </div>
              <ul class="gtk-column-items">
                {group.items.map(item => (
                  <li>
                    <span style="color: #4ade80;">*</span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </section>

      <!-- 3. Featured Projects -->
      <section id="projects" class="simple-section">
        <h2 class="simple-section-title">
          <span class="sec-title-icon">[+]</span> Security Projects & Hands-On Labs
        </h2>

        <div style="display: flex; flex-direction: column; gap: 14px;">
          {projects.map(proj => (
            <article class="gtk-section-panel">
              <div class="gtk-section-titlebar" style="justify-content: space-between;">
                <div style="display: flex; align-items: center; gap: 8px;">
                  <span class="gtk-title-indicator">■</span>
                  <span style="font-size: 0.88rem; font-weight: 700;">{proj.title}</span>
                </div>
                {proj.badge && <span class="gtk-badge featured">{proj.badge}</span>}
              </div>

              <div class="gtk-section-body">
                <p style="font-size: 0.86rem; color: #abb2bf; line-height: 1.5; margin-bottom: 10px;">
                  {proj.summary}
                </p>

                <div style="font-size: 0.78rem; font-family: var(--font-mono); color: #23bac2; margin-bottom: 6px;">
                  Key Implementation Details:
                </div>
                <ul class="doc-bullet-list" style="margin-bottom: 12px;">
                  {proj.bullets.map(b => (
                    <li>
                      <span class="doc-bullet-symbol">*</span>
                      <span>{b}</span>
                    </li>
                  ))}
                </ul>

                <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px;">
                  <div style="display: flex; gap: 6px; flex-wrap: wrap;">
                    {proj.tags.map(t => (
                      <span class="gtk-tag-pill">{t}</span>
                    ))}
                  </div>

                  {proj.links && proj.links.length > 0 && (
                    <div style="display: flex; gap: 8px;">
                      {proj.links.map(link => (
                        <a
                          href={link.url}
                          target={link.external ? '_blank' : '_self'}
                          rel={link.external ? 'noopener' : ''}
                          class="gtk-btn primary small"
                        >
                          <span>{link.label}</span>
                          <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
                        </a>
                      ))}
                    </div>
                  )}
                </div>
              </div>
            </article>
          ))}
        </div>
      </section>

      <!-- 4. Relevant Cybersecurity Experience -->
      <section id="experience" class="simple-section">
        <h2 class="simple-section-title">
          <span class="sec-title-icon">[+]</span> Cybersecurity & Threat Monitoring Experience
        </h2>

        <div class="gtk-ledger-list">
          {relevantExperience.map(exp => (
            <div class="gtk-ledger-entry">
              <div class="entry-header-row">
                <span class="entry-badge">[EXPERIENCE]</span>
                <h3 class="entry-title">{exp.role}</h3>
              </div>
              <div class="entry-meta-bar">
                <span><strong>Organization:</strong> {exp.company}</span>
                <span><strong>Location:</strong> {exp.location}</span>
                <span><strong>Period:</strong> {exp.period}</span>
              </div>
              <ul class="entry-bullet-list">
                {exp.bullets.map(b => (
                  <li>
                    <span class="bullet-symbol">></span>
                    <span>{b}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </section>

      <!-- 5. Past Career History -->
      <section class="simple-section">
        <h2 class="simple-section-title">
          <span class="sec-title-icon">[+]</span> Prior IT & Operations Experience
        </h2>

        <div class="gtk-ledger-list">
          {pastCareers.map(exp => (
            <div class="gtk-ledger-entry">
              <div class="entry-header-row">
                <span class="entry-badge past">[CAREER]</span>
                <h3 class="entry-title">{exp.role}</h3>
              </div>
              <div class="entry-meta-bar">
                <span><strong>Company:</strong> {exp.company}</span>
                <span><strong>Location:</strong> {exp.location}</span>
                <span><strong>Period:</strong> {exp.period}</span>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- 6. Education & Certifications List -->
      <section class="simple-section">
        <h2 class="simple-section-title">
          <span class="sec-title-icon">[+]</span> Education & Credentials
        </h2>

        <div class="gtk-ledger-list" style="margin-bottom: 20px;">
          {educationList.map(edu => (
            <div class="gtk-ledger-entry">
              <div class="entry-header-row">
                <span class="entry-badge edu">[DEGREE]</span>
                <h3 class="entry-title">{edu.degree}</h3>
              </div>
              <div class="entry-meta-bar">
                <span><strong>Institution:</strong> {edu.school}</span>
                <span><strong>Location:</strong> {edu.location}</span>
                <span><strong>Year:</strong> {edu.year}</span>
              </div>
              {edu.coursework && (
                <div class="entry-coursework-note">
                  <strong>Coursework Scope:</strong> {edu.coursework}
                </div>
              )}
            </div>
          ))}
        </div>

        <div class="gtk-ledger-list">
          {certificationsList.map(cert => (
            <div class="gtk-ledger-entry">
              <div class="entry-header-row">
                <span class="entry-badge cert">[VERIFIED]</span>
                <h3 class="entry-title">{cert.name}</h3>
              </div>
              <div class="entry-meta-bar">
                <span><strong>Issuing Body:</strong> {cert.issuer}</span>
                <span><strong>Issued:</strong> {cert.year}</span>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- 7. Verified Certificates Lightbox Gallery -->
      <section id="credentials" class="simple-section">
        <h2 class="simple-section-title">
          <span class="sec-title-icon">[+]</span> Verified Credential Gallery
        </h2>

        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 12px;">
          {certificates.map((cert, index) => (
            <div
              class="filmstrip-thumb simple-cert-card"
              data-index={index}
              data-src={cert.image}
              data-caption={cert.caption}
              style="width: 100%; height: 160px; padding: 8px;"
              tabindex="0"
              role="button"
            >
              <img src={cert.image} alt={cert.title} style="height: 110px; width: 100%; object-fit: contain;" loading="lazy" />
              <span class="thumb-label" style="font-size: 0.74rem; font-weight: 600; color: #d8dee9; margin-top: 6px;">
                {cert.title}
              </span>
            </div>
          ))}
        </div>
      </section>

      <!-- 8. Network Operations Route (Traceroute) -->
      <section id="network-route" class="simple-section">
        <h2 class="simple-section-title">
          <span class="sec-title-icon">[+]</span> Network Nodes & Operations Base (Traceroute)
        </h2>

        <div class="gtk-section-panel">
          <div class="gtk-section-titlebar" style="justify-content: space-between;">
            <div style="display: flex; align-items: center; gap: 8px;">
              <span class="gtk-title-indicator">■</span>
              <span>NETWORK_NODES: [VANCOUVER, BC] &lt;-&gt; [AGUASCALIENTES, MX]</span>
            </div>
            <span class="gtk-badge featured">[LINK ESTABLISHED]</span>
          </div>

          <div class="gtk-section-body" style="padding: 0;">
            <div id="simple-map-container" style="width: 100%; height: 380px; position: relative; background: #0b0e14; overflow: hidden;">
              <div id="simple-map" style="position: absolute; inset: 0; width: 100%; height: 100%;"></div>
            </div>
            <div style="padding: 10px 14px; background: #14171d; border-top: 1px solid #232834; display: flex; justify-content: space-between; align-items: center; font-family: var(--font-mono); font-size: 0.76rem; flex-wrap: wrap; gap: 8px;">
              <span style="color: #abb2bf;"><strong>Active Route:</strong> Aguascalientes, MX [Origin] &rarr; Vancouver, BC [Current Base]</span>
              <span style="color: #4ade80;">[ SECURE LINK ACTIVE • ICMP TRACE OK ]</span>
            </div>
          </div>
        </div>
      </section>

      <!-- 9. Publications & Security Writeups -->
      <section id="writeups" class="simple-section">
        <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px;">
          <h2 class="simple-section-title" style="margin-bottom: 0;">
            <span class="sec-title-icon">[+]</span> Published Security Writeups (Medium)
          </h2>
          <a href="https://medium.com/@mabarajam" target="_blank" rel="noopener" class="gtk-btn primary small">
            <span>Follow on Medium</span>
            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
          </a>
        </div>

        <div class="advisories-list">
          {mediumPosts.map((post, idx) => (
            <article class="gtk-advisory-item">
              <div class="advisory-header-row">
                <div style="display: flex; align-items: center; gap: 8px;">
                  <span class="gtk-badge">[MEDIUM]</span>
                  <span class="advisory-date">{post.date}</span>
                </div>
                <span class="advisory-id">PUB-0{idx + 1}</span>
              </div>

              <h3 class="advisory-title">
                <a href={post.url} target="_blank" rel="noopener">
                  {post.title}
                </a>
              </h3>

              <div class="advisory-footer-row">
                <div class="advisory-tags">
                  {post.tags.map(tag => (
                    <span class="gtk-tag-pill">#{tag}</span>
                  ))}
                </div>

                <a href={post.url} target="_blank" rel="noopener" class="gtk-btn small">
                  <span>Read Article</span>
                  <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
                </a>
              </div>
            </article>
          ))}
        </div>
      </section>

      <!-- 9. Contact Section -->
      <section id="contact" class="simple-section">
        <div class="mail-composer-card">
          <h2 style="font-size: 1.15rem; font-weight: 700; color: #fff; margin-bottom: 2px;">
            Connect with Mario Barajas
          </h2>
          <p style="font-size: 0.84rem; color: #8892b0; margin-bottom: 12px;">
            Available for SOC / Cybersecurity Analyst roles in Vancouver, BC or remote teams worldwide.
          </p>

          <div class="mail-field-row">
            <span class="mail-field-label">Email:</span>
            <div class="mail-field-value">
              <span id="simple-email-display" style="color: #38bdf8; font-weight: 600;">{profile.email}</span>
            </div>
          </div>

          <div class="mail-action-toolbar" style="margin-top: 10px;">
            <a href={`mailto:${profile.email}`} class="gtk-btn primary">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg>
              <span>Send Email</span>
            </a>
            <button class="gtk-btn" id="simple-copy-email-btn">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
              <span id="simple-copy-btn-text">Copy Address</span>
            </button>
            <a href="/resume.pdf" download={profile.resumeFileName} class="gtk-btn">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
              <span>Download Resume</span>
            </a>
          </div>

          <div class="mail-channels-row" style="margin-top: 10px;">
            <div class="channels-label">Professional Profiles:</div>
            <div class="channels-buttons">
              {profile.socials.map(s => (
                <a href={s.url} target="_blank" rel="noopener" class="gtk-btn small">
                  <span>{s.label}</span>
                  <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
                </a>
              ))}
            </div>
          </div>
        </div>
      </section>

      <!-- Trademark Disclaimer -->
      <footer class="simple-footer">
        <p>&copy; 2026 Mario Barajas. All rights reserved.</p>
        <p class="trademark-notice" style="margin-top: 8px;">
          Kali Linux™ and the Kali dragon logo are trademarks of OffSec. This portfolio is not affiliated with or endorsed by OffSec.
        </p>
      </footer>
    </main>
  </div>

  <!-- Lightbox Modal for Credentials Inspection -->
  <div class="cert-lightbox-modal" id="kali-cert-modal" role="dialog" aria-label="Certificate Image Viewer">
    <button class="cert-modal-close" id="cert-modal-close" aria-label="Close viewer">✕</button>
    <button class="cert-modal-nav prev" id="cert-modal-prev" aria-label="Previous certificate">‹</button>
    <button class="cert-modal-nav next" id="cert-modal-next" aria-label="Next certificate">›</button>
    <div class="cert-modal-content">
      <img id="cert-modal-img" class="cert-modal-img" src="" alt="Certificate View" />
      <div id="cert-modal-caption" class="cert-modal-caption"></div>
    </div>
  </div>
</Layout>

<script>
  import maplibregl from "maplibre-gl";
  import * as turf from "@turf/turf";

  function initSimpleMap() {
    const mapEl = document.getElementById("simple-map");
    if (!mapEl) return;

    const tiles = [
      "https://server.arcgisonline.com/ArcGIS/rest/services/Canvas/World_Dark_Gray_Base/MapServer/tile/{z}/{y}/{x}",
    ];

    try {
      const map = new maplibregl.Map({
        container: "simple-map",
        style: {
          version: 8,
          sources: {
            "dark-matter": {
              type: "raster",
              tiles: tiles,
              tileSize: 256,
              attribution: "Esri, DeLorme, NAVTEQ",
            },
          },
          layers: [
            {
              id: "dark-matter-layer",
              type: "raster",
              source: "dark-matter",
              minzoom: 0,
              maxzoom: 20,
            },
          ],
        },
        center: [-110, 36],
        zoom: 2.8,
        attributionControl: false,
      });

      const locations = [
        { name: "Vancouver, BC", coords: [-123.1207, 49.2827] as [number, number], desc: "Current Base | Cybersecurity Operations" },
        { name: "Aguascalientes, MX", coords: [-102.2916, 21.8853] as [number, number], desc: "Origin | Education & Early Career" },
      ];

      locations.forEach(loc => {
        const el = document.createElement("div");
        el.className = "marker";
        new maplibregl.Marker({ element: el })
          .setLngLat(loc.coords)
          .setPopup(new maplibregl.Popup({ offset: 20 }).setHTML(`<h3>${loc.name}</h3><p>${loc.desc}</p>`))
          .addTo(map);
      });

      map.on("load", () => {
        const origin: [number, number] = [-102.2916, 21.8853];
        const destination: [number, number] = [-123.1207, 49.2827];
        const route = turf.greatCircle(turf.point(origin), turf.point(destination));

        map.addSource("route", { type: "geojson", data: route });
        map.addLayer({
          id: "route-line",
          type: "line",
          source: "route",
          layout: { "line-join": "round", "line-cap": "round" },
          paint: {
            "line-color": "#23bac2",
            "line-width": 2.5,
            "line-opacity": 0.8,
          },
        });

        map.addSource("comet", { type: "geojson", data: turf.point(origin) });
        map.addLayer({
          id: "comet-layer",
          type: "circle",
          source: "comet",
          paint: {
            "circle-radius": 5,
            "circle-color": "#f43f5e",
            "circle-blur": 0.1,
            "circle-stroke-width": 3,
            "circle-stroke-color": "rgba(244, 63, 94, 0.5)",
          },
        });

        const arcLength = turf.length(route, { units: "kilometers" });
        const steps = 300;
        let counter = 0;

        function animateComet() {
          counter += 1;
          if (counter >= steps) counter = 0;
          const distance = (counter / steps) * arcLength;
          const currentPoint = turf.along(route, distance, { units: "kilometers" });
          const cometSrc: any = map.getSource("comet");
          if (cometSrc) {
            cometSrc.setData(currentPoint);
          }
          requestAnimationFrame(animateComet);
        }

        animateComet();
        map.resize();
      });

      map.addControl(new maplibregl.NavigationControl({ showCompass: false }), "top-right");

      const ro = new ResizeObserver(() => map.resize());
      ro.observe(mapEl);
      setTimeout(() => map.resize(), 300);
      setTimeout(() => map.resize(), 800);
    } catch (e) {
      console.error("Error init simple map:", e);
    }
  }

  function initSimpleLightbox() {
    const modal = document.getElementById('kali-cert-modal');
    const modalImg = document.getElementById('cert-modal-img') as HTMLImageElement;
    const captionText = document.getElementById('cert-modal-caption');
    const closeBtn = document.getElementById('cert-modal-close');
    const prevBtn = document.getElementById('cert-modal-prev');
    const nextBtn = document.getElementById('cert-modal-next');
    const cards = Array.from(document.querySelectorAll('.simple-cert-card'));

    if (!modal || !modalImg || !captionText || cards.length === 0) return;

    let currentIndex = 0;
    const displayCert = (idx: number) => {
      currentIndex = (idx + cards.length) % cards.length;
      const card = cards[currentIndex];
      if (!card) return;
      modalImg.style.opacity = '0';
      setTimeout(() => {
        modalImg.src = card.getAttribute('data-src') || '';
        captionText.innerText = card.getAttribute('data-caption') || '';
        modalImg.style.opacity = '1';
      }, 100);
    };

    cards.forEach((card, idx) => {
      card.addEventListener('click', () => {
        modal.classList.add('active');
        displayCert(idx);
      });
    });

    const closeLightbox = () => modal.classList.remove('active');
    closeBtn?.addEventListener('click', closeLightbox);
    prevBtn?.addEventListener('click', (e) => { e.stopPropagation(); displayCert(currentIndex - 1); });
    nextBtn?.addEventListener('click', (e) => { e.stopPropagation(); displayCert(currentIndex + 1); });
    modal.addEventListener('click', (e) => { if (e.target === modal) closeLightbox(); });

    document.addEventListener('keydown', (e) => {
      if (!modal.classList.contains('active')) return;
      if (e.key === 'Escape') closeLightbox();
      if (e.key === 'ArrowLeft') displayCert(currentIndex - 1);
      if (e.key === 'ArrowRight') displayCert(currentIndex + 1);
    });
  }

  function initCopyEmail() {
    const btn = document.getElementById('simple-copy-email-btn');
    const txt = document.getElementById('simple-copy-btn-text');
    const disp = document.getElementById('simple-email-display');
    if (!btn || !txt || !disp) return;

    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(disp.innerText.trim());
        txt.innerText = 'Copied!';
        setTimeout(() => { txt.innerText = 'Copy Address'; }, 2000);
      } catch (e) {}
    });
  }

  initSimpleMap();
  initSimpleLightbox();
  initCopyEmail();
</script>

