---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout title={`${post.data.title} | Mario Barajas`} description={post.data.description}>
  <div class="article-page-container">
    <div class="article-window">
      <!-- Kali Reader Header -->
      <header class="article-header-bar">
        <div class="article-nav-links">
          <a href="/blog" class="btn-article-nav">
            <i class="fa-solid fa-arrow-left"></i>
            <span>Back to Blog</span>
          </a>
          <a href="/" class="btn-article-nav secondary">
            <i class="fa-solid fa-desktop"></i>
            <span>Desktop</span>
          </a>
          <a href="/simple" class="btn-article-nav secondary">
            <i class="fa-solid fa-file-lines"></i>
            <span>Simple View</span>
          </a>
        </div>

        <div style="font-family: var(--font-mono); font-size: 0.8rem; color: var(--text-dim);">
          reader@kali: ~/blog/{post.id}.md
        </div>
      </header>

      <!-- Article Title & Meta -->
      <div class="article-title-section">
        <h1 class="article-heading">{post.data.title}</h1>
        <div class="article-meta-row">
          <span><i class="fa-regular fa-calendar"></i> {post.data.date}</span>
          <span>•</span>
          <span><i class="fa-regular fa-user"></i> Mario Barajas</span>
          {post.data.tags && post.data.tags.length > 0 && (
            <>
              <span>•</span>
              <div class="article-tags-wrap">
                {post.data.tags.map(tag => (
                  <span class="project-tag">#{tag}</span>
                ))}
              </div>
            </>
          )}
        </div>
      </div>

      <!-- Markdown Article Content -->
      <div class="article-body-content">
        <Content />
      </div>

      <!-- Article Footer -->
      <footer class="article-footer">
        <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: gap; gap: 12px;">
          <div>
            <h4 style="font-size: 0.95rem; color: #fff;">Mario Barajas</h4>
            <p style="font-size: 0.82rem; color: var(--text-muted);">Cybersecurity Analyst • Vancouver, BC</p>
          </div>
          <div style="display: flex; gap: 8px;">
            <a href="/blog" class="btn-project secondary" style="font-size: 0.8rem;">
              <span>More Articles</span>
            </a>
            <a href="/contact" class="btn-project" style="font-size: 0.8rem;">
              <span>Get in Touch</span>
            </a>
          </div>
        </div>
      </footer>
    </div>
  </div>
</Layout>

<style>
  .article-page-container {
    min-height: 100vh;
    background-color: var(--bg-desktop);
    background-image: url('/desktop/wallpaper.jpg');
    background-size: cover;
    background-position: center;
    background-attachment: fixed;
    padding: 30px 16px;
    display: flex;
    justify-content: center;
    overflow-y: auto;
  }

  .article-window {
    width: 100%;
    max-width: 860px;
    background: var(--bg-glass-heavy);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-active);
    overflow: hidden;
    margin: auto 0;
  }

  .article-header-bar {
    padding: 12px 18px;
    background: rgba(14, 18, 27, 0.95);
    border-bottom: 1px solid var(--border-subtle);
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 10px;
  }

  .article-nav-links {
    display: flex;
    gap: 8px;
  }

  .btn-article-nav {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 12px;
    border-radius: var(--radius-sm);
    font-size: 0.78rem;
    font-weight: 600;
    background: var(--kali-gradient);
    color: #fff;
  }

  .btn-article-nav.secondary {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid var(--border-subtle);
    color: var(--text-secondary);
  }

  .btn-article-nav.secondary:hover {
    background: rgba(255, 255, 255, 0.15);
    color: #fff;
  }

  .article-title-section {
    padding: 32px 32px 16px;
    border-bottom: 1px solid var(--border-subtle);
  }

  .article-heading {
    font-size: 1.8rem;
    font-weight: 800;
    color: #fff;
    line-height: 1.3;
    margin-bottom: 12px;
  }

  .article-meta-row {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.84rem;
    color: var(--text-muted);
    flex-wrap: wrap;
  }

  .article-tags-wrap {
    display: flex;
    gap: 6px;
  }

  .article-body-content {
    padding: 32px;
    color: var(--text-secondary);
    line-height: 1.8;
    font-size: 0.96rem;
  }

  .article-body-content :global(h2) {
    color: #fff;
    font-size: 1.35rem;
    font-weight: 700;
    margin: 2rem 0 1rem;
    padding-bottom: 6px;
    border-bottom: 1px solid var(--border-subtle);
  }

  .article-body-content :global(h3) {
    color: var(--kali-cyan);
    font-size: 1.15rem;
    font-weight: 600;
    margin: 1.5rem 0 0.75rem;
  }

  .article-body-content :global(p) {
    margin-bottom: 1.25rem;
  }

  .article-body-content :global(ul), .article-body-content :global(ol) {
    padding-left: 1.5rem;
    margin-bottom: 1.25rem;
  }

  .article-body-content :global(li) {
    margin-bottom: 0.5rem;
  }

  .article-body-content :global(code) {
    background: rgba(22, 29, 44, 0.9);
    border: 1px solid var(--border-subtle);
    padding: 2px 7px;
    border-radius: 4px;
    color: var(--kali-cyan);
    font-family: var(--font-mono);
    font-size: 0.88em;
  }

  .article-body-content :global(pre) {
    background: rgba(10, 14, 22, 0.95);
    border: 1px solid var(--border-accent);
    border-radius: var(--radius-sm);
    padding: 1.2rem;
    overflow-x: auto;
    margin-bottom: 1.5rem;
  }

  .article-body-content :global(pre code) {
    background: none;
    border: none;
    padding: 0;
    color: #f1f5f9;
  }

  .article-body-content :global(blockquote) {
    border-left: 3px solid var(--kali-cyan);
    padding-left: 1rem;
    color: var(--text-muted);
    font-style: italic;
    margin-bottom: 1.25rem;
  }

  .article-footer {
    padding: 24px 32px;
    background: rgba(14, 18, 27, 0.95);
    border-top: 1px solid var(--border-subtle);
  }
</style>
