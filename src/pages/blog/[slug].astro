---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout title={`${post.data.title} | Mario Barajas`} description={post.data.description}>

  <article>
    <div class="terminal-window" style="margin-bottom: var(--spacing-md);">
      <div class="terminal-header">root@kali: ~/blog/{post.id}</div>
      <div style="padding: var(--spacing-sm);">
        <a href="/blog" style="color: var(--text-dim); text-decoration: none; font-size: 0.85rem;">&lt; cd ../blog</a>
        <h1 style="color: var(--alert); margin-top: var(--spacing-sm);">{post.data.title}</h1>
        <p class="text-dim" style="font-size: 0.85rem; margin-top: 4px;">
          {post.data.date}
          {post.data.tags && post.data.tags.length > 0 && (
            <span> | {post.data.tags.join(' · ')}</span>
          )}
        </p>
      </div>
    </div>

    <div class="terminal-window blog-content">
      <div style="padding: var(--spacing-sm);">
        <Content />
      </div>
    </div>
  </article>

</Layout>

<style>
  .blog-content :global(h2) { color: var(--text-secondary); margin: 1.5rem 0 0.75rem; }
  .blog-content :global(h3) { color: var(--text-primary); margin: 1.25rem 0 0.5rem; }
  .blog-content :global(p)  { margin-bottom: 1rem; line-height: 1.7; }
  .blog-content :global(ul), .blog-content :global(ol) { padding-left: 1.5rem; margin-bottom: 1rem; }
  .blog-content :global(li) { margin-bottom: 0.4rem; }
  .blog-content :global(code) { background: var(--accent); padding: 2px 6px; border-radius: 3px; color: var(--text-primary); font-family: var(--font-mono); }
  .blog-content :global(pre) { background: var(--accent); padding: 1rem; border-radius: 4px; overflow-x: auto; margin-bottom: 1rem; border-left: 3px solid var(--alert); }
  .blog-content :global(pre code) { background: none; padding: 0; }
  .blog-content :global(blockquote) { border-left: 3px solid var(--text-dim); padding-left: 1rem; color: var(--text-dim); margin-bottom: 1rem; }
  .blog-content :global(a) { color: var(--link); }
  .blog-content :global(strong) { color: var(--text-secondary); }
</style>
