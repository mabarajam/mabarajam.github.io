---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Experience | Mario Barajas" description="Cybersecurity work experience, education, and certifications of Mario Barajas.">

  <!-- Experience Section -->
  <section id="experience">
    <h2>> cat work_history.log</h2>

    <p style="color: var(--text-secondary); font-weight: bold; margin-top: var(--spacing-sm); margin-bottom: var(--spacing-sm); font-size: 0.85rem; letter-spacing: 0.1em;">> // RELEVANT_WORK_EXPERIENCE</p>
    <div style="border-left: 2px solid var(--text-dim); padding-left: var(--spacing-sm); margin-bottom: var(--spacing-md);">

      <div style="margin-bottom: var(--spacing-md);">
        <h3 style="color: var(--text-secondary);">Web Security &amp; Network Support</h3>
        <span class="text-dim">English Bay Bike Rentals (Vancouver, BC) | July 2025 - present</span>
        <ul style="margin-top: 8px; padding-left: 20px; color: var(--text-primary); list-style: '> ';">
          <li>Conducted a website vulnerability assessment and delivered remediation recommendations.</li>
          <li>Installed and configured CCTV systems to enhance physical security.</li>
          <li>Optimized company network infrastructure, while also assisting with e-bike repairs and maintenance as needed.</li>
        </ul>
      </div>

      <div style="margin-bottom: var(--spacing-md);">
        <h3 style="color: var(--text-secondary);">AV &amp; Security Camera Technician</h3>
        <span class="text-dim">Wynntek Installations (Vancouver, BC) | Jan 2022 - May 2023</span>
        <ul style="margin-top: 8px; padding-left: 20px; color: var(--text-primary); list-style: '> ';">
          <li>Installed, mounted, and configured surveillance cameras and DVR/NVR systems for optimal coverage and remote network access.</li>
          <li>Mounted TVs and installed audio/sound equipment for residential and commercial clients.</li>
        </ul>
      </div>

      <div style="margin-bottom: var(--spacing-md);">
        <h3 style="color: var(--text-secondary);">IT Support</h3>
        <span class="text-dim">CFHAGS S.A (México) | July 2018 - Nov 2021</span>
        <ul style="margin-top: 8px; padding-left: 20px; color: var(--text-primary); list-style: '> ';">
          <li>Managed and supported 300+ iPads (20 per classroom) across 15-20 classrooms, plus the school's Sistema UNO digital learning platform.</li>
          <li>Administered school network (WiFi, user accounts) and maintained computer lab equipment.</li>
          <li>Coordinated with platform providers for technical issues and system updates.</li>
        </ul>
      </div>
    </div>

    <p style="color: var(--text-secondary); font-weight: bold; margin-bottom: var(--spacing-sm); font-size: 0.85rem; letter-spacing: 0.1em;">> // PAST_CAREER_EXPERIENCES</p>
    <div style="border-left: 2px solid var(--text-dim); padding-left: var(--spacing-sm); margin-bottom: var(--spacing-lg);">
      <div style="margin-bottom: var(--spacing-md);">
        <h3 style="color: var(--text-secondary);">Loan Advisor</h3>
        <span class="text-dim">Spring Financial Inc. (Canada) | Oct 2024 - Feb 2025</span>
      </div>
      <div style="margin-bottom: var(--spacing-md);">
        <h3 style="color: var(--text-secondary);">Store Manager</h3>
        <span class="text-dim">Cloud Ebikes (Canada) | Nov 2021 - Sep 2024</span>
      </div>
      <div style="margin-bottom: var(--spacing-md);">
        <h3 style="color: var(--text-secondary);">Database Assistant</h3>
        <span class="text-dim">DA Comp (Mexico) | Jan 2012 - Jan 2013</span>
      </div>
    </div>
  </section>

  <!-- Education Section -->
  <section id="education">
    <h2>> cat education.txt</h2>
    <div class="terminal-window" style="margin-top: var(--spacing-sm);">
      <ul style="list-style: none;">
        <li style="margin-bottom: var(--spacing-md);">
          <strong style="color: var(--text-secondary);">Cybersecurity Analyst Diploma</strong>
          <div class="text-dim">Cornerstone Community College (Vancouver, BC) | 2025</div>
          <div style="font-size: 0.9em; margin-top: 4px;">(Cybersecurity Fundamentals, Network Defender, Certified Ethical Hacker, Penetration Testing Professional)</div>
        </li>
        <li style="margin-bottom: var(--spacing-md);">
          <strong style="color: var(--text-secondary);">Bachelor of Science</strong>
          <div class="text-dim">Autonomous University of Aguascalientes (Mexico) | 2017</div>
        </li>
        <li style="margin-bottom: var(--spacing-sm);">
          <strong style="color: var(--text-secondary);">Information Technology Technician</strong>
          <div class="text-dim">CBtis 168 (Mexico) | 2012</div>
        </li>
      </ul>
    </div>
  </section>

  <!-- Certifications Section -->
  <section id="certifications" style="margin-top: var(--spacing-md);">
    <h2>> cat certifications.txt</h2>
    <div class="terminal-window" style="margin-top: var(--spacing-sm);">
      <ul style="list-style: none;">
        <li style="margin-bottom: var(--spacing-sm);">
          <strong style="color: var(--text-secondary);">CompTIA Security+ (SY0-701)</strong>
          <div class="text-dim">CompTIA | 2026</div>
        </li>
      </ul>
    </div>
  </section>

</Layout>
